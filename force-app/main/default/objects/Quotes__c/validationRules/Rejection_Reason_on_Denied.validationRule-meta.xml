<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Reason_on_Denied</fullName>
    <active>false</active>
    <errorConditionFormula>AND(

ISPICKVAL( Status__c ,&quot;Denied&quot;),
ISBLANK(TEXT(Rejection_Reason__c ))

)</errorConditionFormula>
    <errorDisplayField>Rejection_Reason__c</errorDisplayField>
    <errorMessage>Please select a Rejection Reason before setting the status to Denied.</errorMessage>
</ValidationRule>
