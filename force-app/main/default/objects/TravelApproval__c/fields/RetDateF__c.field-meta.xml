<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RetDateF__c</fullName>
    <description>Convert Return Date to Date Field</description>
    <formula>DATE(
    VALUE(RIGHT(ReturnDate__c, 4)),
    VALUE(LEFT(ReturnDate__c, 2)),
    VALUE(LEFT(RIGHT(ReturnDate__c, 7), 2)) 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>RetDateF</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
