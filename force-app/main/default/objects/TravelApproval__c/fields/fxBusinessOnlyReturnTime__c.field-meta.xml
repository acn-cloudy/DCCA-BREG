<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>fxBusinessOnlyReturnTime__c</fullName>
    <description>PacPoint: JF - Case #6406 - Travel Phase 1 - Used for DocuSign Templates</description>
    <externalId>false</externalId>
    <formula>CASE(RIGHT(LEFT(TEXT(BusinessOnlyReturnDate__c-0.4166666666667), 13), 2), &quot;13&quot;, &quot;01&quot;, &quot;14&quot;, &quot;02&quot;, &quot;15&quot;, &quot;03&quot;, &quot;16&quot;, &quot;04&quot;, &quot;17&quot;, &quot;05&quot;, &quot;18&quot;, &quot;06&quot;,
&quot;19&quot;, &quot;07&quot;, &quot;20&quot;, &quot;08&quot;, &quot;21&quot;, &quot;09&quot;, &quot;22&quot;, &quot;10&quot;, &quot;23&quot;, &quot;11&quot;, &quot;00&quot;, &quot;12&quot;, RIGHT(LEFT(TEXT(BusinessOnlyReturnDate__c-0.4166666666667), 13), 2)) + &quot;:&quot; +
RIGHT(LEFT(TEXT(BusinessOnlyReturnDate__c-0.4166666666667), 16), 2) + &quot; &quot; +
IF(VALUE(RIGHT(LEFT(TEXT(BusinessOnlyReturnDate__c-0.4166666666667), 13), 2)) &lt; 12, &quot;AM&quot;, &quot;PM&quot;)</formula>
