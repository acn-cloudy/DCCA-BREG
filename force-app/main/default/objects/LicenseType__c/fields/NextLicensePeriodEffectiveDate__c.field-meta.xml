<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NextLicensePeriodEffectiveDate__c</fullName>
    <description>PacPoint-IC080519- Created for PVL phase 1</description>
    <formula>IF
(
((ADDMONTHS( Today() , 6 ))- 1) &gt; LicenseTypeExpireDate__c
,
LicenseTypeExpireDate__c + 1
,
LicenseTypeEffectiveDate__c
)</formula>
    <label>Next License Period Effective Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
