<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PreviousWeekDay__c</fullName>
    <description>PacPoint-FT012619 - Created for phase 1</description>
    <formula>TODAY() - CASE( MOD( DateValue(CreatedDate) - DATE(1900,1,7) ,7) , 0, 2, 1, 3, 1)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Previous Week Day</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
