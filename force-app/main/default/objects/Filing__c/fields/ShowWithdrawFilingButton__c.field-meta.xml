<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ShowWithdrawFilingButton__c</fullName>
    <description>PacPoint-MV012120 - Created for PVL phase 1</description>
    <formula>IF(
 AND(
  NOT(ISPICKVAL(Status__c,&quot;Filing Completed&quot;)),
  NOT(ISPICKVAL(Status__c,&quot;Filing Withdrawn&quot;))
 ),
 true,
 false
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Show Withdraw Filing Button</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
