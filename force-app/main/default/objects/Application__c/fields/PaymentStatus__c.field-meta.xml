<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PaymentStatus__c</fullName>
    <description>PacPoint-IC081419- Created for PVL phase 1</description>
    <externalId>false</externalId>
    <formula>IF(
AND(
 NOT(ISBLANK(OutstandingAmount__c)), 
 OutstandingAmount__c = 0
),
&quot;Paid&quot;, 
&quot;UnPaid&quot;
)</formula>
    <inlineHelpText>Will show paid if all fees are paid. If there are still outstanding fees, the status will be unpaid.</inlineHelpText>
    <label>Payment Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
