<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DateofDegreeFormat</fullName>
    <active>true</active>
    <errorConditionFormula>AND
(
NOT(ISBLANK(DateofDegree2__c)),
NOT(REGEX( DateofDegree2__c ,&quot;^((0[1-9])|(1[0-2]))/[0-9]{4}$&quot;))
)</errorConditionFormula>
    <errorDisplayField>DateofDegree2__c</errorDisplayField>
    <errorMessage>You must enter the Date of Degree in the format MM/YYYY. For example, 01/2021</errorMessage>
</ValidationRule>
