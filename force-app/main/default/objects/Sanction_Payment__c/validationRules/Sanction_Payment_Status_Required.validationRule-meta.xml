<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sanction_Payment_Status_Required</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(Total_Payments__c)) &amp;&amp;
ISPICKVAL(Status__c, &apos;&apos;)</errorConditionFormula>
    <errorMessage>When Amount Due and Total Amount Paid are populated, Status is required.</errorMessage>
</ValidationRule>
