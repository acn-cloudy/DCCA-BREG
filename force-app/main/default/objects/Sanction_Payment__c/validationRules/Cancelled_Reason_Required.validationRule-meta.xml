<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Status__c, &apos;Cancelled&apos;),
ISBLANK( Cancelled_Reason__c ) 
)</errorConditionFormula>
    <errorMessage>Cancelled Reason field is required when Status fields equals &quot;Cancelled&quot;.</errorMessage>
</ValidationRule>
