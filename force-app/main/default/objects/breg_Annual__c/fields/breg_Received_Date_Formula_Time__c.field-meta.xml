<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>breg_Received_Date_Formula_Time__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
ISBLANK(breg_Received_Date__c),
&quot;&quot;,
IF(MOD(HOUR(TIMEVALUE(breg_Received_Date__c - (10/24))), 12) = 0, &quot;12&quot;, TEXT(MOD(HOUR(TIMEVALUE(breg_Received_Date__c - (10/24))), 12))) + &quot;:&quot; +
IF(MINUTE(TIMEVALUE(breg_Received_Date__c - (10/24))) &lt; 10,
&quot;0&quot; + TEXT(MINUTE(TIMEVALUE(breg_Received_Date__c - (10/24)))),
TEXT(MINUTE(TIMEVALUE(breg_Received_Date__c - (10/24))))
)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Received Date Formula Time</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
