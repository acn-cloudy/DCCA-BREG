<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
                name="buttonLabel"
                type="String"
                label="Button Label"
                description="Text shown on the button"
            />
            <property
                name="componentTitle"
                type="String"
                label="Component Title"
                description="Optional card title shown above the button"
            />
            <property
                name="methodName"
                type="String"
                label="Method Name"
                description="Allowed Apex method name handled by BREGCaseController.runMethodByName"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>