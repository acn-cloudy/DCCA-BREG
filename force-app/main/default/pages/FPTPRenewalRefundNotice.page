<apex:page sidebar="false" showHeader="false" controller="RenewalNotificationController" standardStylesheets="false" renderAs="PDF"
    applyHtmlTag="false" applyBodyTag="false">

    <head>
        <style>
            @page {
                margin-top: 0;
            }
            body {
                margin-top: 5px;
                font-size: 11pt;
                font-family: Arial Narrow, Arial;
            }
            li span {
                position: relative;
                left: 3px;
            }
        </style>
    </head>
    <apex:variable value="{!1}" var="rowNum" />
    <body>
        <apex:repeat value="{!records}" var="record">
            <c:RefundNoticeHeader pageStr="A-18.27-16" licenseType="" />
            <div style="padding-left: 50px">
                <c:RefundNoticeSubHeader license="{!record}" dToday="{!dToday}" licenseLabel="License:" subject="Non-renewal of License for"
                />
                <br/>
                <div style="margin-left: 40px; text-align: left;">
                    Please be advised that we are not able to process the renewal application for the</div>
                <div style="text-align: left;">
                    above referenced license because the licensing records reflect that a required 
                    <br/>component (dependency) to your license, such as the principal accountant(s), has failed 
                    <br/>to renew their license and/or permit to practice (PTP). 
                </div>
                <br/>
                <div style="margin-left: 40px; text-align: left;">Failure to complete the renewal process by the above date will result in the </div>
                <div style="text-align: left;">forfeiture of your license at which time you may not do business under this license and 
                    <br/>
                    will be required to restore or re-apply as a new applicant, including submitting a new 
                    <br/>
                    application and all required documents and fees. 
                 </div>
                <br/>
                <div style="margin-left: 40px; text-align: left;">A refund of your renewal fees will be processed if there is no response by the </div>
                <div style="text-align: left;">above date. Please note that processing time for refunds is approximately 8 – 10
                    <br/>
                    weeks. 
                </div>
                <br/>
                <br/>
                <br/>
                <div style="margin-left: 340px; text-align: left;">Records Section</div>
                <div style="margin-left: 340px; text-align: left;">Licensing Branch</div>
            </div>
            <apex:outputPanel rendered="{!rowNum != records.size}">
                <div style="page-break-after:always;"></div>
            </apex:outputPanel>
            <apex:variable var="rowNum" value="{!rowNum + 1}" />
        </apex:repeat>
    </body>
</apex:page>