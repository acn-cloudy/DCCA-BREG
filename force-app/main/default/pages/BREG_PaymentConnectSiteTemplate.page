<style>
/* CSS variables used to override default style values in site_basic.css */
:root {
    --apex-pagemessage-background-color: #fff5cc;
    --apex-pagemessage-border-color: #e8e8e8;
    --apex-pagemessage-border-width: 1px;
    --field-label-color: black;
    --field-label-font-size: .92em;
    --field-border-width: 1px;
    --field-border-color: #a9a9a9;
    --field-border-radius: 2px;
    //--field-border-color-on-focus: #9ecaed;   
    //--field-box-shadow-color: red;//#9ecaed;
    --field-box-shadow-blur: 0px;
    --placeholder-color:  #b9b9b9; // 'transparent' hides placeholder text
}
    
</style>
  
