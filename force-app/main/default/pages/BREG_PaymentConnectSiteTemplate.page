<style>
.pc_logo {
   background: url('{!URLFOR($Resource.pymt__PaymentConnect,'images/LoremIpsum/LoremIpsumLogos.png')}');
   background-repeat: no-repeat;
   background-size:310%;
   background-position: -280px -520px;
   background-position: 0px -520px;
   height: 80px;
   width:260px;
}    
body {
    font-family: 'Open Sans', sans-serif; 
/*     font-family: 'Exo 2', sans-serif;  */
    margin:0px;
    padding:0px;   
    }
.pc_frame_top {
    max-width:900px;
    margin: 0px auto 0px auto;
}
.pc_page_content {
    max-width:900px;
    margin: 0px auto 20px auto;
    }
.pc_page_content_inner {
    padding:0px 20px;
}

.pc_formstone_container {
    max-width:800px; 
    margin-left:auto;
    margin-right:auto;
}
.pc_record_listing_table td, .pc_record_listing_table th,
.pc_opp_line_item_table td, .pc_opp_line_item_table th,
.pc_cart_item_table td, .pc_cart_item_table th {
   padding:7px;
}
/* Nav bar styling overrides */   
/* Menu bar background and text color */
.stellarnav.dark {
  background: #595959;
}
/* submenu background color and border */
.stellarnav.dark ul ul {
  background: white;
  border: 1px solid #808080; /* optional */
  }
/* submenu item text color */
.stellarnav.dark ul ul li a {
  color: black;
  
}
/* submenu item hover */
.stellarnav.dark ul ul li :hover {
  color: white;
  background: #808080;
  
}
.stellarnav.mobile ul ul li a {
  color:white;
}
@media all and (max-width: 500px) {
.pc_page_content_inner {
   padding-left: 5px;
   padding-right: 5px;
}

}

.pc_checkout_heading,
.pc_checkout_totals,
.pc_cart_details {
  display: {!IF(isBregPortal, 'none !important', 'block')};
}

</style>
<script>
  function pcRefreshPageStyling() {
      // (optional) function used to apply styling to page.  Maybe be called again after during page updates and refreshes

      // This example uses the formstone library to apply styling to tool tips and dropdowns.      
      jQuery(".show-tooltip").tooltip({
        direction: "top"
      });      
      jQuery(".pc_formstone_container select").dropdown();


    }
</script>
<body id="htmlBody" >
<div id="topbar" style="width:100%;" >
</div>

    <!--  Edit custom banner and navigation here -->
    <apex:outputPanel rendered="{!NOT(isBregPortal)}">
    <div class="pc_frame_top" >
      <div class="inner">
      <img src="/s.gif" />
      <table width="100%" cellpadding="5">
          <tr>
              <td><apex:image url="{!URLFOR($Resource.DCCALogo)}" height="70"/></td>
              <td><span style="color:#4f5050;font-size:2em;">{!$Organization.Name}</span></td>
          </tr>
      </table>
      </div><!-- inner -->
    </div>
  </apex:outputPanel>

<div class="nav_bar_shadow"></div>

    <div class="pc_frame">
    <div class="pc_frame_inner">

    <apex:insert name="body"/>

<p>&nbsp;</p>

<apex:outputPanel rendered="{!NOT(isBregPortal)}">
    <apex:insert name="footer">
    <!--  Add custom footer here -->
    <div style="text-align:center;width:100%;font-size:.5em;font-weight:bold;font:Verdana;color:#A4A4A4;">Copyright © 2020, State of Hawaii. All rights reserved.</div>
    </apex:insert>
</apex:outputPanel>

    </div><!--  end pc_frame_inner -->
    </div><!--  end pc_frame -->
<script>
    jQuery( document ).ready( function() {
        var isBregPortal = {!IF($CurrentPage.Parameters.mode == 'bregportal', 'true', 'false')};
        if (isBregPortal) {
          sessionStorage.setItem('bregportal', 'true');
        }

        var isBregPortalMode = sessionStorage.getItem('bregportal') === 'true';
        if (isBregPortalMode) {
          var finishButton = jQuery("#siteCheckoutConfirm\\:SiteTemplate\\:checkoutConfirmForm\\:finish");

          // Hide the elements that are not needed in the BREG portal mode
          jQuery("#siteCheckoutConfirm\\:SiteTemplate\\:checkoutConfirmForm\\:checkoutConfirmFormPanel, \
              #siteCheckoutConfirm\\:SiteTemplate\\:j_id6, \
              #siteCheckoutConfirm\\:SiteTemplate\\:j_id113").hide();
          
          // Auto-click the hidden button after a short delay
          setTimeout(function() {
              if(finishButton.length > 0) {
                finishButton.click();
                sessionStorage.removeItem('bregportal'); // clean up before clicking
              }
          }, 10);
        }

        // apply page styling scripts
        //jQuery('.stellarnav').stellarNav();        
        jQuery('.stellarnav').stellarNav({
            theme: 'dark',  // plain, light, dark
            breakpoint: 775,
            menuLabel: 'Menu',
            sticky: false,
            position: 'static', // static, top, left, right
            openingSpeed: 250,
            closingDelay: 250,
            showArrows: true,
            phoneBtn: '7605551212',
            locationBtn: 'https://www.linvio.com',
            closeBtn: false,
            scrollbarFix: false
        }); 
        pcRefreshPageStyling(); // run refresh script
        // Add Disclaimer
        //jQuery('.pc_checkout_totals').after('<p style="margin-top: 40px">We are unable to accept credit cards, e-checks or fund transfers from foreign financial institutions. If your foreign financial institution has affiliations with U.S. banks, please contact them see if they can forward payments on your behalf. We apologize for any inconvenience.</p>');
        
  });
</script>
