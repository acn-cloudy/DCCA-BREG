<apex:page sidebar="false" showHeader="false" controller="JVFormController" standardStylesheets="false" 
    renderAs="PDF"
    applyHtmlTag="false" applyBodyTag="false">
   
    <head>
        <!-- renderAs="PDF" -->
        <style>
            /*
                size: A4 landscape;
                size: 5.5 * 4.25  
                a4  210 * 297 
            */

            @page {
                size: A4 landscape;
                margin: 0;
                size:14in 8.5in;  
            }

            body {
                height: 100%;
                padding: 0;
                margin: 10px 10px 5px 60px;
                font-size: 16px;
                /* background: #fefcae; */
            }

            h1, h2, h3, h4, h5, p {
                margin: 0;
                font-weight: 400;
                padding: 2px;
            }

            h1 {
                font-size: 2em;
            }

            h2 {
                font-size: 1.5em;
            }

            h3 {
                font-size: 1.2em;
            }

            h4 {
                font-size: 1em;
                font-weight: bold;
            }

            h5 {
                font-size: 0.7em;
                font-weight: bold;
            }

            p {
                font-size: 1em;
            }

            table, th, td {
                border: 1px solid black;
                border-collapse: collapse;
                text-align: center;
                padding: 0;
            }

            table {
                width: 100%;
            }

            table tbody td{
                padding: 2px 0;
            }
        </style>
    </head>

    <body>
        <apex:variable var="cnt" value="{!0}" />
        <apex:repeat var="value" value="{!values}" >
            <apex:variable var="cnt" value="{!cnt+1}" />
            <body>
                <c:JV record="{!value}" />
            </body>
            <apex:outputPanel rendered="{!cnt != values.size}">
            <div style="page-break-after:always;"></div>
            </apex:outputPanel>
        </apex:repeat>
    </body>

</apex:page>