<apex:page controller="CE_FutureCoursesController"
            readOnly="true"
           applyHtmlTag="false"
           sidebar="false"
           showHeader="false"
           renderAs="pdf"
           >
<html>
<head>
    <style>
        body table {
            width: 100%;
            font-size: 7pt;
            
            -fs-table-paginate: paginate;
        }

        @page {
            @top-center {
                content: element(header);
            }

            @bottom-left {
                content: element(footer);
            }
        }

        div.footer {
            font-size: 9pt;
            display: block;
            padding: 5px;
            position: running(footer);
        }

        .pageNumber:before {
            content: counter(page);
        }

        .pageCount:before {
            content: counter(pages);
        }

        .header {
            border-top: 1px solid #000000;
            border-bottom: 1px solid #000000;
            text-align: center;
            position: running(header);
        }

        table .cs th {
            border-top: 1px solid black;
            border-bottom: 1px solid black;
            padding-right: 5px;
        }

        table .cs th,
        table td {
            text-transform: uppercase;
            vertical-align: top;
            padding-top: 5px;
            padding-bottom: 5px;
        }

        div.island {
            font-weight: :unset;
            font-size: 9pt;
        }
    </style>
</head>
    <body>
    <div class="header">
        SCHEDULED {!IF(courseTypeFilter == 'p', 'PRELICENSE','CONTINUING')} EDUCATION COURSES
    </div>
    <div class="footer">
        <div style="float:left; width: 50%;">
            <apex:outputText value="{0, date, EEEE, MMMM d, yyyy}">
                <apex:param value="{!TODAY()}"/>
            </apex:outputText>
        </div>
        <div style="float:right; text-align: right;">Page <span class="pageNumber"/> of <span class="pageCount"/></div>
    </div>
    <apex:repeat value="{!results}" var="r">
        <div style="margin-top: 10px;">
            
            <table cellpadding="0" cellspacing="0">
                <thead>
                <tr>
                    <th class="island">{!r.island}</th>    
                </tr>
                <tr class="cs">
                    <th style="width: 55px;">
                        START DATE
                    </th>
                    <th style="width: 40px;">
                        TIME
                    </th>
                    <apex:outputText rendered="{!courseTypeFilter=='p'}" escape="false">
                        <th style="width: 45px;">
                            END DATE
                        </th>
                    </apex:outputText>
                    <th style="{!IF(courseTypeFilter == 'p','width: 125px;', 'width: 180px;')}">
                        COURSE
                    </th>
                    <th style="width: 40px;">
                            {!IF(courseTypeFilter == 'p', 'MEDIUM', 'CREDIT HOURS')}
                    </th>
                    <th style="width: 50px;">
                        PROVIDER
                    </th>
                    <th style="width: 80px;">
                        LOCATION
                    </th>
                    <th style="width: 60px;">
                        CITY
                    </th>
                    <th style="width: 50px;">
                        TELEPHONE
                    </th>
                </tr>
                </thead>
                <tbody>
                <apex:repeat value="{!r.courses}" var="c">
                    <tr>
                        <td>
                            <apex:outputText value="{0, date, MM/d/yyyy}">
                                <apex:param value="{!c.course.StartDate__c}"/>
                            </apex:outputText>
                        </td>
                        <td>
                                {!c.formattedStartTime}
                        </td>
                        <apex:outputText rendered="{!courseTypeFilter=='p'}" escape="false">
                            <td>
                                <apex:outputText value="{0, date, MM/d/yyyy}">
                                    <apex:param value="{!c.course.EndDate__c}"/>
                                </apex:outputText>
                            </td>
                        </apex:outputText>
                        <td>
                                {!c.course.Provider_School_Subject__r.Subject__r.Name}
                        </td>
                        <td>
                                {!IF(courseTypeFilter == 'p', c.course.Medium__c ,c.course.Credits__c)}
                        </td>
                        <td>
                                {!c.course.Account__r.Name}
                        </td>
                        <td>
                            <apex:outputText value="{!c.course.Address__c +  ' ' + c.course.City__c + ' ' + c.course.State__c + ', ' + c.course.ZipCode__c}"
                                    escape="false"/> 
                        </td>
                        <td>
                                {!c.course.City__c}
                        </td>
                        <td>
                                {!c.course.Account__r.AdministratorPhone__c}
                        </td>
                    </tr>
                </apex:repeat>
                </tbody>
            </table>
        </div>
    </apex:repeat>
    </body>
    <body>
        <div style="page-break-after:always;"></div>
        <div class="header">
            {!IF(courseTypeFilter == 'p', 'PRELICENSE EDUCATION SCHOOLS','CONTINUING EDUCATION PROVIDERS')}            
        </div>
        
        <table cellpadding="0" cellspacing="0">
            <colgroup>
                <col span="1" style="width: 200px;" />
                <col span="1" style="width: 50px;" />
                <col span="1" style="width: 50px;" />
                <col span="1" style="width: 300px;" />
             </colgroup>
            <thead>
            <tr class="cs">
                <th colspan="3">PROVIDER</th>
                <th>CONTACT</th>
            </tr>
            </thead>
            <tbody>
            <apex:repeat value="{!coursesSchools}" var="school">
                <tr>
                    <td colspan="3">
                        <div>{!school.Name}</div>
                        <div>{!school.AdministratorStreet1__c}</div>
                        <div style="display:grid">
                            <div style="float:left;width:150px;">{!school.AdministratorCity__c}</div>
                            <div style="float:left;width:30px;">{!school.AdministratorState__c}</div>
                            <div style="float:left">{!school.AdministratorZipcode__c}</div>
                        </div>
                    </td>
                    <td>
                        <div>{!school.AdministratorPhone__c}</div>
                        <div>{!school.AdministratorEmail__c}</div>
                        <div>{!school.Website}</div>
                    </td>
                </tr>
                <tr style="height: 10px"><td></td></tr>
            </apex:repeat>
            </tbody>
        </table>
    </body>
</html>
</apex:page>