<apex:component >
  <apex:attribute name="record" description="This is the value for the component." type="License__c" />
<div style="width: 525px; 
  height: 407px;
  box-sizing: border-box;
  position: relative;
  font-family: sans-serif;
  font-size:15px;">
  <div style="
      position: absolute;
      left: 5%;
      bottom: 5%;
      width: 90%;
      ">
    <img src="{!$Resource.LogoBlack}" width="100%" />
  </div>

  <div style="position: relative; padding: 30px;">
    <div style="text-align: center">
      <div style="font-size:1.5em; margin-bottom: 10px">LICENSE RENEWAL NOTICE</div>
      <div style="font-size:1em; font-weight: bold;">Renewal Begins:
        <apex:outputText value="{0,date,medium}">
          <apex:param value="{!record.LicenseType__r.StartofRenewalPeriod__c}" />
        </apex:outputText> through</div>
      <div style="font-size:1em; font-weight: bold;">
        <apex:outputText value="{0,date,medium}">
          <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
        </apex:outputText> Midnight (HST)</div>
      <div style="font-size:1.05em; font-weight: bold; margin:10px 0;">Renew Online at:
        <u><apex:outputText value="{!$Label.MyPVLLink}" /></u>
      </div>
    </div>
    <div style="font-size:0.7em">
      <b>For more information go to: </b>
      <u>https://cca.hawaii.gov/pvl</u>
    </div>
    <div style="position: relative; font-size:0.7em">
      <div style="width:55%; display: inline-block;">
        <ul style="padding-left:0;padding:0 5px;margin:0;">
          <li style="padding-left: 10px">Go to your licensing area’s web page</li>
          <li style="padding-left: 10px">Select “Renewal &amp; Restoration”</li>
        </ul>
        <div style="border:2px dotted;
          margin: 15px 30px 0 0;
          padding-top: 5px;">
          <b>***
            <u>Pocket IDs MUST Be Printed Online</u>***</b>
          <ul style="padding-left:0;padding:0 5px;margin:3px 0;">
            <li style="padding-left: 10px">
              <b>
                <u>You must retrieve and print</u>
              </b> your pocket
              <br/>&nbsp; ID card online via your MyPVL account.
              <br/>&nbsp;
              <u>No other notice will be provided.</u>
            </li>
            <li style="padding-left: 10px">Any requests to have one mailed to you
              <br/>&nbsp; will be at a charge of $10</li>
          </ul>
        </div>
      </div>
      <div style="width:44%;display:inline-block;vertical-align:top;margin-top:5px;">
        <b>Check the status of your renewal at: </b>
        <ul style="padding-left:0;padding:0 5px;margin:0;">
          <li style="padding-left: 10px">{!$Label.PVLSearchBreak}
          </li>
          <li style="padding-left: 10px">Select “Pending Application”</li>
        </ul>
        <br/>
        <b>*Processing time for renewals:</b>
        <ul style="padding-left:0;padding:0 5px;margin:0;">
          <li style="padding-left: 10px">Online: 3-5 business days</li>
          <li style="padding-left: 10px">Hardcopy: 14-21 business days
            <div>*Subject to licensee meeting all requirements and may be longer due to high volume of renewals received.</div>
          </li>
          <li style="padding-left: 10px">Early submittals are recommended.</li>
        </ul>

      </div>
    </div>
    <div style="margin-top:10px;">
      <div style="width:20%;display: inline-block;">
        <img src="{!$Resource.DCCALogoBlack}" width="80" />
      </div>
      <div style="width: 79%;display:inline-block;">
        <div style="font-size:0.8em;font-weight:bold;font-style:italic;text-align:center;">
          <div>A license that is not renewed by the</div>
          <div>license expiration date is
            <u>unlicensed</u> and shall not practice</div>
        </div>
        <div style="font-size: 0.6em; font-weight:bold;margin-top:5px"> If you cannot renew online or prefer to mail in your renewal: </div>
        <div style="font-size: 0.6em">Contact the licensing branch at (808) 586-3000 to request a renewal application. </div>
      </div>

    </div>

  </div>
</div>
</apex:component>