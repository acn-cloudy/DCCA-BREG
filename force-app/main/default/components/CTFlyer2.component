<apex:component >
    <apex:attribute name="record" description="This is the value for the component." type="License__c" />
    <div style="width: 525px;height: 407px;font-size:10px;box-sizing: border-box;position: relative;font-family: sans-serif;">
        <div style="position: relative; padding: 30px 30px 0 30px;">
            <p style="margin-bottom:5px; text-align:center;">
                State of Hawaii Department of Commerce and Consumer Affairs Professional &amp; Vocational Licensing Division
            </p>
            <div style="position: relative;">
                <div style="width:47%;display:inline-block;margin:0 0 3px 0;vertical-align:top;">
                    <p>
                        <b>Deadline to renew online is:</b>
                        <br/> Midnight (HST)
                        <apex:outputText value="{0, date, MMMM d','  yyyy}">
                            <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                        </apex:outputText>
                    </p>
                    <p style="margin-top:5px;">
                        <b>HOW TO RENEW YOUR LICENSE ONLINE:
                            <br/> Go to MyPVL:</b> <apex:outputText value="{!$Label.MyPVLLink}" />
                    </p>
                    <ul>
                        <li style="margin-top:5px"> If you have already created an account enter your account email and password and select "Log In".</li>
                        <li style="margin-top:5px">If you forgot your password select "Forgot Password" and follow instructions to reset your password.</li>
                        <li style="margin-top:5px">If you have not created an account select "Sign Up" to create an account, then return to MyPVL to
                            "Log In".</li>
                        <li style="margin-top:5px">If you need to add your license to your account: Select "Find my License"
                            <div>
                                <div style="margin-left:10%">Select License Type: “CT-Contractor”
                                    <br/>Enter your license number
                                    <br/> Enter your SSN or file number
                                </div>
                                Sole Proprietor or RME - enter last 4 digits of your SSN
                                <br/> Entity/Firm - enter last 4 digits of firm’s File Number**
                                <br/> **(“File Number” is printed in the “License Data” section on the hardcopy renewal application
                                that was mailed to you)
                                <br/> Select "Link"
                            </div>
                        </li>
                        <li style="margin-top:5px">To access renewal form select "Renew" complete renewal form and submit payment of fees.</li>
                    </ul>
                    <p style="margin:5px 0 0 5px;">
                        <b>
                            Note: You do not need to submit hardcopy documents when renewing online unless requested to do so.
                        </b>
                    </p>
                </div>
                <div style="width:52%;display:inline-block;">
                    <div style="margin-left:10%">
                        <p>
                            <b>HOW TO RENEW YOUR LICENSE BY HARDCOPY:</b>
                            Follow instructions included with your hardcopy renewal application.
                        </p>
                        <p style="margin-top:5px;">
                            <b>
                                <u>*For Active Firms/Sole Owners Only:</u>
                            </b>
                            <br/> Additional requirements to include with your completed application.
                            <b>(Refer to instructions for more details)</b>
                        </p>
                        <p style="margin-top:5px;">
                            <u>
                                <b>Note:</b> Name on all documents must match your license name
                            </u>
                        </p>
                        <ul style="list-style:none">
                            <li>*Proof of Hawaii State Tax Clearance</li>
                            <li>*Proof of general liability and workers compensation insurance or exclusion
                                <br/> (If insurance is valid past 
                                <apex:outputText value="{0, date, MM/dd/yyyy}">
                                    <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                                </apex:outputText>
                                proof of insurance not required)</li>
                            <li>*Proof of Bond if required to maintain
                                <br/> (If bond is valid past 
                                <apex:outputText value="{0, date, MM/dd/yyyy}">
                                    <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                                </apex:outputText>
                                proof of bond not required)</li>
                        </ul>
                        <p style="margin-top:10px;">
                            <b>
                                All Hardcopy Renewal Applications:
                                <br/>
                                <br/>Must be postmarked or delivered in person to the DCCA by
                                <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                    <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                                </apex:outputText>
                            </b>
                        </p>
                    </div>

                    <p style="margin-top:10px;">
                        <b>Renewals after 
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                            </apex:outputText>
                            and by 
                            <apex:outputText value="{0, date, MMMM d','  yyyy}">
                                <apex:param value="{!record.LicenseType__r.RestorationDeadline__c}" />
                            </apex:outputText>
                            : Must be submitted by mail or in person
                            and an additional fee of $50.00 must be paid for late renewals.</b>
                    </p>
                    <p style="margin-top:10px;"><b>
                        Renewals after 
                        <apex:outputText value="{0, date, MMMM d','  yyyy}">
                            <apex:param value="{!record.LicenseType__r.RestorationDeadline__c}" />
                        </apex:outputText>
                        will not be accepted and will require licensee to 
                        reapply as a new licensee and meet all current requirements.
                    </b></p>

                </div>
            </div>
        </div>
    </div>
</apex:component>