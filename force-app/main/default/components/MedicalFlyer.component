<apex:component >
    <apex:attribute name="record" description="This is the value for the component." type="License__c" />
    <div style="width: 525px;height: 407px;font-size:10px;box-sizing: border-box;position: relative;font-family: sans-serif;">
        <div style="position: relative; padding:80px 30px 0 30px;">
            <div style="position: absolute;width: 45%;left: 0;top: 80px;">
                <img src="{!$Resource.LogoBlack}" width="100%" />
            </div>
            <div style="position: relative;">
                <div style="width:28%;display:inline-block;margin:0 2% 23px 0;vertical-align:bottom;">
                    <h1 style="text-align:center;">renew</h1>
                    <h1>
                        <span style="font-size:0.6em;">YOUR</span>
                        license
                    </h1>
                    <h1 style="text-align:right;">
                        <span style="font-size:0.6em;">ONLINE</span>
                    </h1>
                </div>
                <div style="width:69%;display:inline-block;text-align:center;">
                    <h5>
                        State of Hawaii Department of Commerce and Consumer Affairs
                        <br/> Professional &amp; Vocational Licensing Division
                    </h5>
                    <p style="margin:20px 0">
                        <b>Notice Applies To License Types:</b> Physician (MD), Podiatrist (PO), Emergency Medical Technician (EMT),
                        Emergency Medical Technician-Advanced (EMTA) and Emergency Medical Technician-Paramedic (EMTP)</p>
                    <h4>Renewals begin 
                        <b><apex:outputText value="{0, date, EEEE MMMM d',' yyyy}">
                            <apex:param value="{!record.LicenseType__r.StartofRenewalPeriod__c}" />
                        </apex:outputText></b>
                
                        through Midnight (HST) 
                        <apex:outputText value="{0, date, MMMM d',' yyyy}">
                            <apex:param value="{!record.LicenseType__r.LicenseTypeExpireDate__c}" />
                        </apex:outputText>
                        at <b><apex:outputText value="{!$Label.MyPVLLink}" /></b>
                    </h4>
                </div>
            </div>

            <p style="text-align:center;margin:20px 0 20px 20%;">
                <b>Licensees selected for audit of CME may not renew online.</b>
                <br/> You are required to submit a hardcopy renewal and supporting documents per the audit instructions contained
                in a memorandum from the Hawaii Medical Board dated 
                <apex:outputText value="{0, date, MMMM d',' yyyy}">
                    <apex:param value="{!record.LicenseType__r.RunAuditDate__c}" />
                </apex:outputText>
                .
            </p>
            <p style="text-align: center;"><b>
                It’s secure, fast and simple!
                <br/> Pay by credit card or checking account and have a receipt emailed to you.
            </b></p>
        </div>
    </div>
</apex:component>