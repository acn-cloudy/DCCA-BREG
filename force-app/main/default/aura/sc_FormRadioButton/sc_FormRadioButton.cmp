<aura:component >
    <aura:attribute name="options" type="string[]" access="global"/>
    <aura:attribute name="value" type="String" access="global" />
    <aura:attribute name="name" type="String" access="global" />
    <aura:attribute name="valid" type="Boolean" access="global" />
    <aura:attribute name="required" type="Boolean" access="global" default="false" />
	<div aura:id="Radio" class="slds-form-element__control slds-grid">
        <aura:iteration items="{#v.options}" var="option">                       
            <aura:if isTrue="{#(option == v.value)}">
            	<lightning:input type="radio"
                             label="{#option}" 
                             name="{#v.name}" 
                             value="{#option}" 
                             onchange="{!c.check}" 
                             onblur="{!c.validate}"
                             checked="true"
                             />
            </aura:if>
            <aura:if isTrue="{#(option != v.value)}">
            	<lightning:input type="radio"
                             label="{#option}" 
                             name="{#v.name}" 
                             value="{#option}" 
                             onchange="{!c.check}" 
                             onblur="{!c.validate}"
                             />
            </aura:if>
            
        </aura:iteration>
    </div>
    <aura:if isTrue="{!v.valid != true}">
		<div id="error" class="slds-form-element__help slds-required">
            This field is required
        </div>
    </aura:if>
</aura:component>