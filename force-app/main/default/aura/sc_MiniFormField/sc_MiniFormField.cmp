<aura:component >
    <aura:attribute name="label" type="string" access="global" />
    <aura:attribute name="subLabel" type="string" access="global" />
    <aura:attribute name="required" type="Boolean" access="global" default="false" />
    <aura:attribute name="hidden" type="Boolean" access="global" default="false" />
    <aura:attribute name="showCondition" type="Object" access="global"  />
    <aura:attribute name="helpText" type="String" access="global" default="" />
    <aura:attribute name="inputInFront" type="Boolean" access="global" default="false" />
    <aura:if isTrue="{!!v.hidden}">
        <aura:if isTrue="{!!v.inputInFront}" >
            <div class="slds-form-element ">
                <Lightning:formattedRichText value="{#v.label}" class="slds-form-element__label" aura:id="instructions"/>
                <aura:if isTrue="{!v.required}">
                    <abbr class="slds-required" title="required">*</abbr>
                </aura:if>
                <aura:if isTrue="{#v.helpText != null }">
                    <c:sc_HelpIcon popuphelp="{!v.helpText}" />
                </aura:if>
                {!v.body}
                <aura:if isTrue="{!v.subLabel != null }">
                    <Lightning:formattedRichText value="{!v.subLabel}" class="slds-form-element__label" aura:id="instructions"/>
                </aura:if>            
            </div>
            <aura:set attribute="else">
                <div class="slds-form-element slds-p-vertical_xx-small slds-grid slds-wrap">
                    <div class="slds-col slds-size_1-of-12" style="margin-top: 5px;">
                        {!v.body}
                    </div>
                    <div class="slds-col slds-size_11-of-12"  >
                        <Lightning:formattedRichText value="{#v.label}" class="slds-form-element__label" aura:id="instructions"/>
                        
                        <aura:if isTrue="{#v.helpText != null }">
                            <c:sc_HelpIcon popuphelp="{!v.helpText}" />
                        </aura:if>
                    </div>
                </div>
            </aura:set>
        </aura:if>
    </aura:if>
</aura:component>