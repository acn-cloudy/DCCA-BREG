<aura:component >
    <aura:attribute name="value" type="Date" />
    <aura:attribute name="change" type="Object" />
    <aura:attribute name="dateValidation" type="string" access="global" default="" />    
    <aura:attribute name="errors" type="Object[]" access="global" />
    <aura:attribute name="maxDate"  type="string" access="global" />
    <aura:method name="validate" action="{!c.doValidate}" />

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <lightning:input aura:id="input" type="date" label="" variant="label-hidden" value="{!v.value}"
        onchange="{!v.change}" max="{!v.maxDate}" />

</aura:component>