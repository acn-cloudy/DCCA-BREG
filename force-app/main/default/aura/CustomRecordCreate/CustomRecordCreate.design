	<design:attribute name="sObjectName" label="sObject API Name" />
    <design:attribute name="layoutName" label="Layout Name" />
    <design:attribute name="recordTypeName" label="Record Type Label" />
    <design:attribute name="saveButtonLabel" label="Save Button Label" />
    <design:attribute name="finishButtonLabel" label="Finish Button Label" />
    
    <design:attribute name="displayMap" label="Display map (true or false)" />
	<design:attribute name="latitudeField" label="Latitude Field API Name" />
	<design:attribute name="longitudeField" label="Longitude Field API Name" />
	
	<design:attribute name="displayUpload" label="Display Upload Page" />
	<design:attribute name="uploadLabel1" label="Upload File 1 Label" />
	<design:attribute name="uploadLabel2" label="Upload File 2 Label" />
	<design:attribute name="uploadLabel3" label="Upload File 3 Label" />
	<design:attribute name="uploadLabel4" label="Upload File 4 Label" />
	<design:attribute name="uploadLabel5" label="Upload File 5 Label" />
	
	<design:attribute name="hideNameField" label="Hide Name Field" description="Used to specify if need to hide the name field" />
</design:component>