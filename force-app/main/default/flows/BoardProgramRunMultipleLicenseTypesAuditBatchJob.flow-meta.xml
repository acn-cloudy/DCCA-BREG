        <picklistField>NameType__c</picklistField>
        <picklistObject>LicenseName__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>recChoice_LicenseTypes</name>
        <dataType>String</dataType>
        <displayField>LicenseTypeCodeAndName__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BoardProgram__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>AuditCushionPercent__c</field>
            <operator>IsNull</operator>
            <value>
