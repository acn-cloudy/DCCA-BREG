    <actionCalls>
        <description>Use values from earlier in the flow to set the inputs for the &quot;Audit User Selected Licenses&quot; Apex action. To use its outputs later in the flow, store them in variables.</description>
        <name>AuditUserSelectedLicenses</name>
        <label>Audit User Selected Licenses</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <actionName>BatchFlagMultipleLicenseForAudit</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>selectedLicenses</name>
            <value>
                <elementReference>LicenceTypes</elementReference>
            </value>
        </inputParameters>
