            </value>
        </filters>
        <object>LicenseType__c</object>
        <outputAssignments>
            <assignToReference>varN_SelectedAuditCushionPercent</assignToReference>
            <field>AuditCushionPercent__c</field>
        </outputAssignments>
        <valueField>Name</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Count the number of special character &apos;;&apos; in the license types checkbox group. There will be (n - 1) semicolons where n is the number of user selected license types.</description>
        <name>forN_CountSelectedLicenseTypes</name>
        <dataType>Number</dataType>
        <expression>LEN({!LicenceTypes}) - LEN( SUBSTITUTE({!LicenceTypes}, &apos;;&apos;, &apos;&apos;) )</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Board Program: Run Multiple License Types Audit Batch Job {!$Flow.CurrentDateTime}</interviewLabel>
