    <description>JF 6/12/23: Used to create License History records on the License. - Update license history effective date for DELQ</description>
    <environments>Default</environments>
    <formulas>
        <name>CurrentLicensePeriod</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!Get_License.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!Get_License.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License.LicenseTypeEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!Get_License.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!Get_License.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License.LicenseTypeExpireDate__c}))</expression>
    </formulas>
    <formulas>
        <name>DELQEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_License.EffectiveExpireDate__c} + 1</expression>
    </formulas>
    <formulas>
        <name>EffectiveDate</name>
        <dataType>Date</dataType>
        <expression>{!InputLicense.CancelDate__c} + 1</expression>
    </formulas>
    <formulas>
        <name>EffectiveDateforTF</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Associated_License.EntityLicense__r.Ins_Expire_Cancel_Date__c}), TODAY(), {!Get_Associated_License.EntityLicense__r.Ins_Expire_Cancel_Date__c})</expression>
    </formulas>
    <formulas>
        <name>EffectiveDateForZT</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_License.Ins_Expire_Cancel_Date__c}), TODAY(), {!Get_License.Ins_Expire_Cancel_Date__c})</expression>
    </formulas>
    <formulas>
        <name>EntityInsuranceTermDate</name>
        <dataType>Date</dataType>
        <expression>
If(ISNULL({!Get_Associated_License.EntityLicense__r.InsuranceBondTermDate__c}),
{!Get_Associated_License.EntityLicense__r.Insurance_Bond_Cancel_Date__c} + 1,{!Get_Associated_License.EntityLicense__r.InsuranceBondTermDate__c} + 1)</expression>
    </formulas>
    <formulas>
        <name>InsuranceEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISNULL({!Get_License.InsuranceBondTermDate__c}),
{!Get_License.Insurance_Bond_Cancel_Date__c} + 1,
{!Get_License.InsuranceBondTermDate__c}+ 1)</expression>
    </formulas>
    <formulas>
        <name>NextLicensePeriod</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!Get_License.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!Get_License.LicenseType__r.NextLicensePeriodEffectiveDate__c} ))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License.LicenseType__r.NextLicensePeriodEffectiveDate__c} ))
+ &quot; - &quot; 
+ TEXT(MONTH({!Get_License.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!Get_License.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License.LicenseType__r.NextLicensePeriodExpireDate__c}))</expression>
    </formulas>
    <formulas>
        <name>OnlineApplicationTypeFlow</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!InputApplication.OnlineApplicationType__c}) , &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Privilege</name>
        <dataType>String</dataType>
        <expression>IF(
  {!RenewingPermittoPractice} = &apos;No&apos;
    ,&apos;&apos;
    ,BLANKVALUE(TEXT({!InputLicense.Privilege__c}),&apos;&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>Remarks</name>
        <dataType>String</dataType>
        <expression>TRIM(
    IF( 
        NOT(
            ISBLANK({!Privilege})
        )
        , &quot;RENEWED WITH &quot; + {!Privilege}
        , IF( 
            {!RenewingPermittoPractice} = &apos;No&apos;
            , &quot;RENEWED WITHOUT PERMIT TO PRACTICE&quot;
            , &quot;&quot;)) 
    + &quot; &quot;
    + IF( 
        NOT(
            ISBLANK({!OnlineApplicationTypeFlow}))
    ,&quot;ELECTRONIC RENEWAL&quot;
    ,&quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>RenewingPermittoPractice</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!InputApplication.RenewingPermittoPractice__c}),&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>SuspenseDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 22</expression>
    </formulas>
    <formulas>
        <name>SuspenseDateforZI</name>
        <dataType>Date</dataType>
        <expression>{!Get_License.Ins_Expire_Cancel_Date__c}+ 59</expression>
    </formulas>
    <formulas>
        <name>TransactionType</name>
        <dataType>String</dataType>
        <expression>CASE({!InputApplication.Type__c}
    , &quot;RNEW - Renewal&quot;
    , &quot;RNEW - RENEWED&quot;
    , &quot;RSTR - Restore - No A/I Status&quot;
    , &quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;
    , &quot;LICF - New License after Forfeiture&quot;
    , &quot;LICF - NEW LICENSE AFTER FORFEITURE&quot;
    , &quot;REAC - Reactivation&quot;
    , &quot;REAC - REACTIVATED&quot;
   , &quot;ADDP - Additional Special Privilege&quot;
    , &quot;ADDP - ADD SPECIAL PRIVILEGE&quot;
    , &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>TransactionTypeBouncedCheck</name>
        <dataType>String</dataType>
        <expression>CASE(
{!InputApplication.Type__c} , 

&quot;RNEW - Renewal&quot;, &quot;BCRN - BOUNCED CHECK - RENEWAL&quot;, 

&quot;RSTR - Restore - No A/I Status&quot;, &quot;BCRS - BOUNCED CHECK - RESTORATION&quot;,

&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>TransactionTypeBouncedCheckPaidLICNLICF</name>
        <dataType>String</dataType>
        <expression>CASE(
{!InputApplication.Type__c}, 
&quot;LICN - New License&quot;, &quot;BPNL - BOUNCED CHECK REPAYMENT, NEW LICENSE&quot;, 
&quot;LICF - New License after Forfeiture&quot;, &quot;BPLF - BOUNCED CHECK REPAYMENT, LICF&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>TransactionTypeBouncedCheckPaidRNEWRSTR</name>
        <dataType>String</dataType>
        <expression>CASE(
{!InputApplication.Type__c}, 
&quot;RNEW - Renewal&quot;, &quot;BPRN - BOUNCED CHECK RENEWALS, REPAYMENT RENEWALS&quot;, 
&quot;RSTR - Restore - No A/I Status&quot;, &quot;BPRS - BOUNCED CHECK RENEWALS, REPAYMENT RESTORATION&quot;,
&quot;&quot;)</expression>
    </formulas>
