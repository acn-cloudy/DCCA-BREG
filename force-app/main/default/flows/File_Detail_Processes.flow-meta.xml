NOT(ISBLANK([FileDetails__c].Filing__r.Reviewer__c )
)
)
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISNEW(),
NOT(ISBLANK({!myVariable_current.Filing__r.Reviewer__c} )
)
)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(
ISNEW(),
NOT(ISBLANK([FileDetails__c].Exam__c )),
NOT(ISBLANK([FileDetails__c].Exam__r.AssistantExaminer__r.Id)),

OR(
$User.Id != [FileDetails__c].Exam__r.OwnerId,
$User.Id != [FileDetails__c].Exam__r.AssistantExaminer__r.Id
)  
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISNEW(),
NOT(ISBLANK({!myVariable_current.Exam__c} )),
NOT(ISBLANK({!myVariable_current.Exam__r.AssistantExaminer__r.Id})),

OR(
{!$User.Id} != {!myVariable_current.Exam__r.OwnerId},
{!$User.Id} != {!myVariable_current.Exam__r.AssistantExaminer__r.Id}
)  
)</expression>
