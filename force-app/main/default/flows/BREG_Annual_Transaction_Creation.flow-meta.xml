<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assignment_1</name>
        <label>Assign Transaction records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>transaction.breg_Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.breg_Account__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>transaction.breg_Transaction_Code__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ANN</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>transaction.breg_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>E</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>transaction.breg_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_ReceivedDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>transaction.breg_Filing_Year__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Flining_Year_Number</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Transaction_Records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_BREG_Settings</name>
        <label>Check BREG Settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assignment_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Global_Data_Migration_Triggers_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.BREG_Setting__c.Global_Data_Migration_Triggers_Disabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Global Data Migration Triggers Disabled</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Flining_Year_Number</name>
        <dataType>Number</dataType>
        <expression>Value({!$Record.breg_Filing_Year__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_ReceivedDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.breg_Received_Date__c})</expression>
    </formulas>
    <interviewLabel>BREG Annual Transaction Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BREG Annual Transaction Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Transaction_Records</name>
        <label>Create Transaction Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Transaction_Lookup</targetReference>
        </connector>
        <inputReference>transaction</inputReference>
    </recordCreates>
    <recordUpdates>
        <name>Update_Transaction_Lookup</name>
        <label>Update Transaction Lookup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>BREG_Transaction__c</field>
            <value>
                <elementReference>transaction.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_BREG_Settings</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>breg_Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>breg_Annual__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Filing_Year</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>transaction</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>breg_Transaction__c</objectType>
    </variables>
    <variables>
        <name>transaction_array</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>breg_Transaction__c</objectType>
    </variables>
</Flow>
