+ TEXT(DAY({!Get_License_Record.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License_Record.LicenseTypeEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!Get_License_Record.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!Get_License_Record.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!Get_License_Record.LicenseTypeExpireDate__c}))</expression>
