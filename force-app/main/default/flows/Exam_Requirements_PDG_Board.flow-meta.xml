    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Are_there_2_attempts_of_failed_test_result</name>
        <label>Are there 2 attempts of failed test result?</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NumberOfAttempts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Failed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NewFailedResult__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_Board_Program_PDG</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_Board_Program_PDG</name>
        <label>Is the Board Program PDG?</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Application.LicenseType__r.BoardProgram__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BOARD OF PRIVATE DETECTIVES AND GUARDS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Exam_Eligibility_Start_Date</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>JF 6/2/2023: Flow for New Exam Requirements for PDG Board</description>
    <environments>Default</environments>
    <formulas>
        <name>NumberOfAttempts</name>
        <dataType>Number</dataType>
        <expression>MOD({!$Record.NumberofAttempts__c},2)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>PhaseXStartDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date__c} + 90</expression>
    </formulas>
    <interviewLabel>Exam Requirements: PDG Board {!$Flow.CurrentDateTime}</interviewLabel>
