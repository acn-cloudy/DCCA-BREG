    <description>JF 8/28/23 - Update for license status formula to address issue of application paid after license restored.</description>
    <environments>Default</environments>
    <formulas>
        <name>LicenseStatusFormula</name>
        <dataType>String</dataType>
        <expression>IF(
OR(TEXT({!Get_Current_License.Status__c}) = &quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;,
TEXT({!Get_Current_License.Status__c}) = &quot;DM - Forfeited/Maintenance Requirement Due&quot;,
TEXT({!Get_Current_License.Status__c}) = &quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;),
&quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;C - Current, Valid &amp; In Good Standing&quot;)</expression>
    </formulas>
    <formulas>
        <name>RNEWRSTRLicenseHistory</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!Get_Application.Type__c}) = &quot;RNEW - Renewal&quot;, 
&quot;RNEW - RENEWED&quot;,
&quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;)</expression>
    </formulas>
