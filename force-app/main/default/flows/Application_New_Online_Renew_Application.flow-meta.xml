<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>JF - 4/15/24 -Update for SOQL Queries 101 Error</description>
    <environments>Default</environments>
    <formulas>
        <description>Used to select the Complete Application by Date based on Type of Application.</description>
        <name>CompleteApplicationByDate</name>
        <dataType>Date</dataType>
        <expression>IF(
TEXT({!$Record.Type__c}) = &quot;RNEW - Renewal&quot;,
{!$Record.CurrentLicense__r.EffectiveExpireDate__c} , 
{!$Record.CurrentLicense__r.RestorationDeadline__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to calculate what the license period should be set to on the Application.</description>
        <name>LicensePeriodFormula</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.Type__c}) = &quot;RNEW - Renewal&quot;, 
TEXT(MONTH({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c})),

TEXT(MONTH({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))

)</expression>
    </formulas>
    <formulas>
        <name>OnlineRenewalBusinessAddressFormula</name>
        <dataType>String</dataType>
        <expression>If({!Get_Application.CurrentLicense__r.BusinessStreet__c} = &quot;&quot;,
&quot; &quot;,
{!Get_Application.CurrentLicense__r.BusinessStreet__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.BusinessCity__c} + &quot;, &quot; + TEXT({!Get_Application.CurrentLicense__r.BusinessState__c}) + &quot;, &quot; + TEXT({!Get_Application.CurrentLicense__r.BusinessCountry__c}) + &quot;, &quot; + {!Get_Application.CurrentLicense__r.BusinessZipCode__c})</expression>
    </formulas>
    <formulas>
        <name>OnlineRenewalMailingAddressFormula</name>
        <dataType>String</dataType>
        <expression>If({!Get_Application.CurrentLicense__r.MailingStreet__c} = &quot;&quot;,
&quot; &quot;,
{!Get_Application.CurrentLicense__r.MailingStreet__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.MailingCity__c} + &quot;, &quot; + TEXT({!Get_Application.CurrentLicense__r.MailingState__c}) + &quot;, &quot; + TEXT({!Get_Application.CurrentLicense__r.MailingCountry__c}) + &quot;, &quot; + {!Get_Application.CurrentLicense__r.MailingZipCode__c})</expression>
    </formulas>
    <formulas>
        <name>OnlineRenewalResidenceAddressFormula</name>
        <dataType>String</dataType>
        <expression>If({!Get_Application.CurrentLicense__r.ResidenceStreet__c} = &quot;&quot;,
&quot; &quot;,
{!Get_Application.CurrentLicense__r.ResidenceStreet__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.ResidenceCity__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.ResidenceState__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.ResidenceCountry__c} + &quot;, &quot; + {!Get_Application.CurrentLicense__r.ResidenceZipCode__c})</expression>
    </formulas>
