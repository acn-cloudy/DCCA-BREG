<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_expedited_boolean_to_true</name>
        <label>Set expedited boolean to true</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isExpeditedPaymentExists</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Find_expedited_payment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Name_of_Entity_Previous_From_Entity</name>
        <label>Set Name of Entity Previous from Name of Entity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.breg_Name_of_the_Entity_Previous__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.breg_Name_of_the_Entity__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Find_transaction_line_item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Name_of_Entity_Previous_From_New_Name</name>
        <label>Set Name of Entity Previous from New Entity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.breg_Name_of_the_Entity_Previous__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.breg_New_Entity_Name__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Find_transaction_line_item</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Show_validation_error</name>
        <label>Show validation error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>You can not change Processing speed to Normal after payment been made.</errorMessage>
            <fieldSelection>breg_Processing_Speed__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_BREG_Settings</name>
        <label>Check BREG Settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Status_Changed_To_Rejected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Global_Data_Migration_Triggers_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.BREG_Setting__c.Global_Data_Migration_Triggers_Disabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Global Data Migration Triggers Disabled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_cashier_code</name>
        <label>Check cashier code</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Find_expedited_payment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Expedited</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_expedited_payment.CashierCode__r.breg_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expedite Fees</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_expedited_boolean_to_true</targetReference>
            </connector>
            <label>Expedited</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_New_Entity_Name_Populated</name>
        <label>Check New Entity Name Populated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Name_of_Entity_Previous_From_Entity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Use Name of Entity</defaultConnectorLabel>
        <rules>
            <name>New_Entity_Name_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.breg_New_Entity_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Name_of_Entity_Previous_From_New_Name</targetReference>
            </connector>
            <label>New Entity Name Not Empty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status_Changed_To_Rejected</name>
        <label>Check Status Changed To Rejected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Find_transaction_line_item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Changed_To_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_New_Entity_Name_Populated</targetReference>
            </connector>
            <label>Status Changed To Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Processing_speed_is_changed</name>
        <label>Processing speed is changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>From_expedited_to_normal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.breg_Processing_Speed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Normal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.breg_Processing_Speed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expedited</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_transaction_line_item</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isExpeditedPaymentExists</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_validation_error</targetReference>
            </connector>
            <label>From expedited to normal</label>
        </rules>
    </decisions>
    <description>Added validation for expedited processing speed</description>
    <environments>Default</environments>
    <interviewLabel>Case - Before update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BREG Case - Before update</label>
    <loops>
        <name>Find_expedited_payment</name>
        <label>Find expedited payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Find_transaction_line_item</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_cashier_code</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Processing_speed_is_changed</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_transaction_line_item</name>
        <label>Find transaction line item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Find_expedited_payment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>breg_Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>PaidStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>1000.0</numberValue>
        </limit>
        <object>TransactionLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_BREG_Settings</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>isExpeditedPaymentExists</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
