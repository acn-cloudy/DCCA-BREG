    <decisions>
        <name>Check_if_Current_user_is_Case_Owner</name>
        <label>Check if Current user is Case Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Need_to_reassign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Incorrect owner</defaultConnectorLabel>
        <rules>
            <name>User_is_Case_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseOwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>currentUserId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Required_Fields</targetReference>
            </connector>
            <label>User is Case Owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Required_Fields</name>
        <label>Check Required Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Transaction_Lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Missing_Required</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Refund_Case.breg_Submitted_To__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Refund_Case.breg_Submission_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Missing_Required_Screen</targetReference>
            </connector>
            <label>Missing Required</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
