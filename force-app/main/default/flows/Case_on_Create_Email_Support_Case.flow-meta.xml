<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Update_Collection</name>
        <label>Add to Update Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>col_LinkstoUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_File_Links</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_File_Links</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Visibility</name>
        <label>Assign Visibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Through_File_Links.Visibility</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Update_Collection</targetReference>
        </connector>
    </assignments>
    <description>Flow to populate fields on a case when an Email Support case is created</description>
    <environments>Default</environments>
    <formulas>
        <name>form_IncomingDivCalc</name>
        <dataType>String</dataType>
        <expression>TRIM(
  RIGHT({!$Record.Owner:Group.Name}, 
    LEN({!$Record.Owner:Group.Name}) - FIND(&quot; &quot;, {!$Record.Owner:Group.Name}, 
      LEN({!$Record.Owner:Group.Name}) - 6
    )
  )
)</expression>
    </formulas>
    <interviewLabel>Case on Create: Email Support Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case on Create: Email Support Case</label>
    <loops>
        <name>Loop_Through_File_Links</name>
        <label>Loop Through File Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_File_Link</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Visibility</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_content_links</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get files attached to case created to set the visibility to all users</description>
        <name>Get_File_Link</name>
        <label>Get File Link</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Through_File_Links</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedEntityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Visibility</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>AllUsers</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContentDocumentLink</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_content_links</name>
        <label>Update content links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>col_LinkstoUpdate</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Incoming_Division</name>
        <label>Update Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <stringValue> </stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Incoming_Division__c</field>
            <value>
                <elementReference>$Record.Incoming_Division_calc__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Incoming_Division</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Visibility_of_Attached_Files</name>
            <connector>
                <targetReference>Get_File_Link</targetReference>
            </connector>
            <label>Visibility of Attached Files</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_LinkstoUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
</Flow>
