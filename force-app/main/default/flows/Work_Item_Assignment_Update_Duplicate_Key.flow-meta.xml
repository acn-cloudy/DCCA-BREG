    <formulas>
        <name>form_Duplicate_Key</name>
        <dataType>String</dataType>
        <expression>{!$Record.Assigned_Clerk__r.Id} &amp;
&quot;_&quot; &amp;
{!$Record.Board_Program__r.Id} &amp;
&quot;_&quot; &amp;
{!$Record.License_Type__r.Id} &amp;
&quot;_&quot; &amp;
TEXT({!$Record.Clerk_Type__c}) &amp;
&quot;_&quot; &amp;
IF({!$Record.Active__c}, &quot;A&quot;, &quot;I&quot;)</expression>
    </formulas>
    <interviewLabel>Work Item Assignment: Update Duplicate Key {!$Flow.CurrentDateTime}</interviewLabel>
