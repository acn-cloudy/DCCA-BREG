    <description>JF 1/25/24: Update License for Entity Makes Good on Insurance within 60 days
MTX SK 08/10/26: Update License Status to &apos;R&apos; or &apos;C&apos; conditionally and triggering criteria to run flow when specifically updated to meet entry criteria. Removed Get Insurance &amp; Bonds element as it&apos;s not used anywhere.</description>
    <environments>Default</environments>
    <formulas>
        <name>LicenseStatusUpdate</name>
        <dataType>String</dataType>
        <expression>IF(TODAY() &gt;= {!Get_License.LicenseType__r.StartofRenewalPeriod__c} &amp;&amp; TODAY() &lt;= {!Get_License.LicenseType__r.EndofRenewalPeriod__c}, &quot;R - Valid Thru Expiration Date, Subject To Renewal&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;)</expression>
    </formulas>
    <formulas>
        <name>NumberOfRequiredInsuranceTypes</name>
        <dataType>Number</dataType>
        <expression>IF(PICKLISTCOUNT({!Get_License.LicenseType__r.InsuranceBondTypesRequired__c})==0, 0, PICKLISTCOUNT({!Get_License.LicenseType__r.InsuranceBondTypesRequired__c})+1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>StatusDueToLossOfInsurance</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_License.LicenseType__r.StatusDuetoLossofInsurance__c})</expression>
    </formulas>
