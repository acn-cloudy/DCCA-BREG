    <description>PacPoint KN 11/15/2023 - Used to create a task when a portal document is uploaded to an application AND/OR when a fee is paid on the portal. This task will be assigned to the owner of the Application.</description>
    <environments>Default</environments>
    <formulas>
        <name>ContactId</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.Applicant__r.Type}) = &quot;012t0000000PLy1AAG&quot;,
{!$Record.Applicant__r.Contact__r.Id},
{!$Record.Applicant__r.Id})</expression>
    </formulas>
    <formulas>
        <name>Description</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
ISCHANGED({!$Record.UploadedPortalDocument__c}),
NOT(ISNULL({!$Record.UploadedPortalDocument__c}))), 
&quot;A Document has been uploaded on the portal for this Application, please review and update&quot;,
&quot;The Applicant has paid the outstanding fee on the portal, please review and update&quot;
)</expression>
    </formulas>
    <formulas>
        <name>EmailDescription</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
ISCHANGED({!$Record.UploadedPortalDocument__c}),
NOT(ISNULL({!$Record.UploadedPortalDocument__c}))), 
&quot;A Document has been uploaded on the portal for this Application, please review and update:&quot;
&amp;BR()
&amp;{!SalesforceURL},
&quot;The Applicant has paid the outstanding fee on the portal, please review and update:&quot;
&amp;BR()
&amp;{!SalesforceURL}
)</expression>
    </formulas>
    <formulas>
        <name>IntegrationUserOwnerID</name>
        <dataType>String</dataType>
        <expression>&quot;005t00000022GqIAAU&quot;</expression>
    </formulas>
    <formulas>
        <name>RecipientList</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.Email}</expression>
    </formulas>
    <formulas>
        <name>SalesforceURL</name>
        <dataType>String</dataType>
        <expression>{!$Label.SalesforceURL}&amp;&quot;/&quot;&amp;{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
ISCHANGED({!$Record.UploadedPortalDocument__c}),
NOT(ISNULL({!$Record.UploadedPortalDocument__c}))), 
&quot;Portal Document Uploaded on Application: &quot;&amp; {!$Record.Name}, 
&quot;Outstanding Amount Due = $0 on Application: &quot;&amp; {!$Record.Name}
)</expression>
    </formulas>
