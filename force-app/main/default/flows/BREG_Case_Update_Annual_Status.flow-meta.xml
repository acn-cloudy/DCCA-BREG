<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Annual_Added</name>
        <label>Check Annual Added</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AnnualAdded</name>
            <conditionLogic>1 AND (2 OR 3) AND (4 OR 5 OR 6 OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.breg_Annual__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.breg_Annual__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Received</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Annual</targetReference>
            </connector>
            <label>Annual Added/Updated</label>
        </rules>
        <rules>
            <name>Annual_Removed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.breg_Annual__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.breg_Annual__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Annual_To_Not_Field</targetReference>
            </connector>
            <label>Annual Removed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_BREG_Settings</name>
        <label>Check BREG Settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Annual_Added</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Global_Data_Migration_Triggers_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.BREG_Setting__c.Global_Data_Migration_Triggers_Disabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Global Data Migration Triggers Disabled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Case_Record_Type</name>
        <label>Check Case Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_BREG_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BREG_Case</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Annual_Added</targetReference>
            </connector>
            <label>Is BREG Case</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>annualReceivedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(ISBLANK({!$Record.breg_Submission_Date__c}), {!$Flow.CurrentDateTime}, {!$Record.breg_Submission_Date__c})</expression>
    </formulas>
    <formulas>
        <name>newAnnualStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Status}) = &apos;Received&apos;, &apos;F&apos;, IF(TEXT({!$Record.Status}) = &apos;Approved&apos; || TEXT({!$Record.Status}) = &apos;Completed&apos;, &apos;P&apos;, IF(TEXT({!$Record.Status}) = &apos;Rejected&apos;, {!oldAnnualStatus}, &apos;&apos;)))</expression>
    </formulas>
    <formulas>
        <name>oldAnnualStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.breg_Entity__r.breg_Entity_Status__c}) = &apos;Annual report 1 yr delinquent (1)&apos; || TEXT({!$Record.breg_Entity__r.breg_Entity_Status__c}) = &apos;Annual report 2 yr delinquent (2)&apos;, &apos;D&apos;, &apos;N&apos;)</expression>
    </formulas>
    <interviewLabel>BREG Case - Update Annual Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BREG Case - Update Annual Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Annual</name>
        <label>Update Annual To Pending</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Prev_Annual_To_Not_Field</targetReference>
        </connector>
        <inputAssignments>
            <field>breg_Case__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Received_Date__c</field>
            <value>
                <elementReference>annualReceivedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Status__c</field>
            <value>
                <elementReference>newAnnualStatus</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.breg_Annual__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Annual_To_Not_Field</name>
        <label>Update Annual To Not Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.breg_Annual__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>breg_Case__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Received_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Status__c</field>
            <value>
                <elementReference>oldAnnualStatus</elementReference>
            </value>
        </inputAssignments>
        <object>breg_Annual__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Prev_Annual_To_Not_Field</name>
        <label>Update Prev Annual To Not Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.breg_Annual__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>breg_Case__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Received_Date__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>breg_Status__c</field>
            <value>
                <elementReference>oldAnnualStatus</elementReference>
            </value>
        </inputAssignments>
        <object>breg_Annual__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_BREG_Settings</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>breg_Annual__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>breg_Annual__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
