        <locationX>440</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Priority 3</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_BREG_Settings</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>breg_Processing_Speed__c</field>
