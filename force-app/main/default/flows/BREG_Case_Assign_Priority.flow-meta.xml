    <decisions>
        <name>Check_BREG_Settings</name>
        <label>Check BREG Settings</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Get_BREG_Case_RT</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Global_Data_Migration_Triggers_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.BREG_Setting__c.Global_Data_Migration_Triggers_Disabled__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Global Data Migration Triggers Disabled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Case_Record_Type</name>
        <label>Check Case Record Type And Processing Speed</label>
        <locationX>440</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Case_Priority_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_BREG_Case_RT.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.breg_Processing_Speed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expedited</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Priority_2</targetReference>
            </connector>
            <label>Update Case Priority 2</label>
        </rules>
        <rules>
            <name>Update_Case_Priority_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_BREG_Case_RT.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.breg_Processing_Speed__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Expedited</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Priority_3</targetReference>
            </connector>
            <label>Update Case Priority 3</label>
        </rules>
    </decisions>
    <environments>Default</environments>
