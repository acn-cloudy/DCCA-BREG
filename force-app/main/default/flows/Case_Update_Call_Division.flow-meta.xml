<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Incoming_Division_Variable</name>
        <label>Assign Incoming Division Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_IncomingDivisonVoiceCall</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Incoming_Division__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Incoming_Division_Variable_1</name>
        <label>Assign Incoming Division Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_IncomingDivisonVoiceCall</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Division__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This decision checks to see if the api call from the call record from CCAIP provides the division data. If not available, the data will populate based on the materialized menu path field on the call record.</description>
        <name>Division_Data_Available</name>
        <label>Division Data Available?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Incoming_Division_Variable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Available</defaultConnectorLabel>
        <rules>
            <name>Yes_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Division__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Incoming_Division_Variable_1</targetReference>
            </connector>
            <label>Yes - Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Incoming_Division_Null</name>
        <label>Incoming Division Null?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Null</defaultConnectorLabel>
        <rules>
            <name>Yes_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Incoming_Division__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Division</targetReference>
            </connector>
            <label>Yes Null</label>
        </rules>
    </decisions>
    <description>This flow will update the incoming division field on the case when the voice call session incoming division is updated after the call is over.</description>
    <environments>Default</environments>
    <interviewLabel>Case: Update Call Division {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: Update Call Division</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get parent case of voice call session record</description>
        <name>Get_Case_Record</name>
        <label>Get Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Incoming_Division_Null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UJET__Case__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_Division</name>
        <label>Update Case Division</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case_Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Incoming_Division__c</field>
            <value>
                <elementReference>var_IncomingDivisonVoiceCall</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Division_Data_Available</targetReference>
        </connector>
        <filterLogic>((1 OR 2 OR 3 OR 7) AND 4) OR (5 AND 6)</filterLogic>
        <filters>
            <field>Incoming_Division__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>OCP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Incoming_Division__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PVL</stringValue>
            </value>
        </filters>
        <filters>
            <field>Incoming_Division__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>INS</stringValue>
            </value>
        </filters>
        <filters>
            <field>UJET__Materialized_Menu_Path__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Division__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Division__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Incoming_Division__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>BRE</stringValue>
            </value>
        </filters>
        <object>UJET__UJET_Session__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_IncomingDivisonVoiceCall</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
