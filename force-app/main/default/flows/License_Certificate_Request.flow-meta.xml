    <decisions>
        <name>Create_Transaction</name>
        <label>Create Transaction?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Success_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Generate_Transaction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Transaction_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>PacPoint KN 11/14/2023 - Converted from an Action and Process Builder into a screenflow. Used to create Certificate Requests for Licenses, also creates Transactions and Transaction Lines</description>
    <dynamicChoiceSets>
        <name>CertificateTypes</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>CertificateType__c</picklistField>
        <picklistObject>CertificateRequest__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Amount</name>
        <dataType>Number</dataType>
        <expression>IF(
{!Certificate_Type} = &quot;B - POCKET ID &amp; WALL CERTIFICATE&quot;, 
20, 
10
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CashierCode</name>
        <dataType>String</dataType>
        <expression>IF(
{!recordId.LicenseType__r.BoardProgram__r.Name} = &quot;REAL ESTATE COMMISSION&quot;, 
{!$Label.REB_Wall_Cert_Pocket_ID_Fee}, 
{!$Label.Duplicate_ID_Fee_Cashier_Code}
)</expression>
    </formulas>
    <formulas>
        <name>Description</name>
        <dataType>String</dataType>
        <expression>Case( 
{!Certificate_Type},
&quot;VR - VERIFICATION REQUEST&quot;, &quot;License Verification Request&quot;,
&quot;P - POCKET IDENTIFICATION CARD&quot;, &quot;Pocket ID Request&quot;, 
&quot;C - WALL CERTIFICATE&quot;, &quot;Wall Certificate Request&quot;, 
&quot;B - POCKET ID &amp; WALL CERTIFICATE&quot;, &quot;Pocket ID AND Wall Certificate Request&quot;,
&quot;&quot;
)</expression>
    </formulas>
    <interviewLabel>License: Certificate Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>License: Certificate Request</label>
