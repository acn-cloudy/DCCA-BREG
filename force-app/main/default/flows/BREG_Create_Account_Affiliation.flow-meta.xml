    <formulas>
        <name>AffiliationRole</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Agent},
    &quot;Agent&quot;,
    IF(
        CONTAINS(LOWER({!Get_Form_Configuration.breg_Form_Name__c}), &quot;limited liability company&quot;),
        IF(
            {!Get_case.breg_Is_Manager_Managed__c},
            &quot;Manager&quot;,
            &quot;Member&quot;
        ),
        IF(
            CONTAINS(LOWER({!Get_Form_Configuration.breg_Form_Name__c}), &quot;partnership&quot;),
            &quot;Partner&quot;,
            IF(
                CONTAINS(LOWER({!Get_Form_Configuration.breg_Form_Name__c}), &quot;corporation&quot;),
                &quot;Officer&quot;,
                &quot;&quot;
            )
        )
    )
)</expression>
    </formulas>
