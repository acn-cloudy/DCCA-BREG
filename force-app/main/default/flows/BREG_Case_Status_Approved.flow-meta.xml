    <formulas>
        <name>BillingState</name>
        <dataType>String</dataType>
        <expression>IF (TEXT({!$Record.breg_Company_Address__CountryCode__s}) = &apos;US&apos;, TEXT({!$Record.breg_Company_Address__StateCode__s}), null)</expression>
    </formulas>
    <formulas>
        <name>BillingStateText</name>
        <dataType>String</dataType>
        <expression>IF (TEXT({!$Record.breg_Company_Address__CountryCode__s}) = &apos;US&apos;, null, TEXT({!$Record.breg_Company_Address__StateCode__s}))</expression>
    </formulas>
    <formulas>
        <description>For TNTMSM it&apos;s Applicant Name
For NBR it&apos;s breg_Name_of_the_Entity__c</description>
        <name>EntityName</name>
        <dataType>String</dataType>
        <expression>IF ({!IsTNTMSMForm} &amp;&amp; TEXT({!Get_Applicant_Acc_Aff.breg_Type__c}) = &apos;Entity&apos;, {!Get_Applicant_Acc_Aff.breg_Entity_Name__c},
IF ({!IsTNTMSMForm} &amp;&amp; TEXT({!Get_Applicant_Acc_Aff.breg_Type__c}) = &apos;Individual&apos;, {!Get_Applicant_Acc_Aff.breg_First_Name__c} &amp; &apos; &apos; &amp; {!Get_Applicant_Acc_Aff.breg_Last_Name__c},
{!$Record.breg_Name_of_the_Entity__c}
))</expression>
    </formulas>
    <formulas>
        <name>EntityType</name>
        <dataType>String</dataType>
        <expression>IF(
    OR({!IsNBRForm}, {!IsTNTMSMForm}, {!IsNameReservationForm}),
    IF(
        ISBLANK(TEXT({!$Record.breg_Form_Configuration__r.breg_Entity_Type__c})),
        TEXT({!$Record.breg_Entity_Type__c}),
        TEXT({!$Record.breg_Form_Configuration__r.breg_Entity_Type__c})
    ),
    NULL
)</expression>
    </formulas>
    <formulas>
        <name>fBusinessStructure</name>
        <dataType>String</dataType>
        <expression>CASE(
{!$Record.breg_Form_Configuration__r.breg_Business_Structure__c},
&quot;Cooperative&quot;, &quot;Cooperative&quot;,
&quot;Corporation&quot;, &quot;Corporation&quot;,
&quot;General Partnership&quot;, &quot;Partnership&quot;,
&quot;Limited Partnership&quot;, &quot;Partnership&quot;,
&quot;Limited Liability Partnership&quot;, &quot;Partnership&quot;,
&quot;Limited Liability Company&quot;, &quot;Limited Liability Company&quot;,
null
)</expression>
    </formulas>
    <formulas>
        <name>MailingState</name>
        <dataType>String</dataType>
        <expression>IF (TEXT({!$Record.breg_Mailing_Address__CountryCode__s}) = &apos;US&apos;, TEXT({!$Record.breg_Mailing_Address__StateCode__s}), null)</expression>
    </formulas>
    <formulas>
        <name>MailingStateText</name>
        <dataType>String</dataType>
        <expression>IF (TEXT({!$Record.breg_Mailing_Address__CountryCode__s}) = &apos;US&apos;,  null, TEXT({!$Record.breg_Mailing_Address__StateCode__s}))</expression>
    </formulas>
    <formulas>
        <name>TNTMSMName</name>
        <dataType>String</dataType>
        <expression>IF (TEXT({!$Record.breg_Form_Code__c}) = &apos;T-1&apos;, {!$Record.breg_Name_of_the_Entity__c},
{!$Record.breg_TNTMSM_Description__c}
)</expression>
    </formulas>
    <formulas>
        <description>first 80 symbols of the tntmsm name</description>
        <name>tntmsmName80</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.breg_TNTMSM_Description__c},80)</expression>
    </formulas>
    <formulas>
        <name>today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
