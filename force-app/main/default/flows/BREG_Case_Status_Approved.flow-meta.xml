    <formulas>
        <name>ApplicantName</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.breg_Applicant_Is_Entity__c}, {!$Record.breg_Applicant_Name__c}, {!$Record.breg_Applicant_First_Name__c} &amp; &apos; &apos; &amp; {!$Record.breg_Applicant_Last_Name__c})</expression>
