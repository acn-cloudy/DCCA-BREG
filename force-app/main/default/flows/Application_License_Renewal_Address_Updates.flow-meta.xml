    <formulas>
        <name>EmployerAddressEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>IF(
ISBLANK({!Get_Application.EmployerStreet__c}),
NULL,
{!Get_Application.ApplicationReceivedDate__c})</expression>
    </formulas>
    <formulas>
        <name>LicenseStatusFormula</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Get_Current_License.Status__c}), 
&quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, &quot;CM - Current, Valid, &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;R - Valid Thru Expiration Date, Subject To Renewal&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;D - Forfeited; Needs to Restore&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;DM - Forfeited/Maintenance Requirement Due&quot;, &quot;CM - Current, Valid, &amp; In Good Standing/Maint. Requirement Due&quot;,
 null)</expression>
    </formulas>
    <formulas>
        <name>RNEWRSTRLicenseHistory</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!Get_Application.Type__c}) = &quot;RNEW - Renewal&quot;, 
&quot;RNEW - RENEWED&quot;,
&quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;)</expression>
    </formulas>
