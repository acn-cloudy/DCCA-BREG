            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SOCTDueDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.Today__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SOCTDeadlineEmailSent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
