    <formulas>
        <description>Days from BREG Setting Resubmission_Due_Date_Days__c, default 45</description>
        <name>ResubmissionDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + IF(ISBLANK({!Get_BREG_Setting.Resubmission_Due_Date_Days__c}), 45, {!Get_BREG_Setting.Resubmission_Due_Date_Days__c})</expression>
    </formulas>
    <formulas>
        <description>Replace a semicolon (;) with a line break in SelectedReasonLabels var and add &apos; - &apos; to each line.</description>
        <name>SelectedReasonPreparedOutputText</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!SelectedReasonLabels}), &apos;&apos;,
&apos; - &apos; &amp; SUBSTITUTE( {!SelectedReasonLabels}, &quot;;&quot;, BR() &amp; &apos; - &apos;)
)</expression>
    </formulas>
