    <decisions>
        <name>Check_Form_Code_for_Assignment_Rules</name>
        <label>Check Form Code for Assignment Rules</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Case_with_Assignment_Rules</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Skip_Assignment_Rules</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DOCDLVR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>ANN-</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ODC</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ADD</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ADD-MEMBER</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.breg_Form_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ADD-TNTMSM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case</targetReference>
            </connector>
            <label>Skip Assignment Rules</label>
        </rules>
    </decisions>
    <decisions>
