    <formulas>
        <description>Formula to bring in the correct cashier code based on division and status</description>
        <name>CalculatedCashierCode</name>
        <dataType>String</dataType>
        <expression>CASE({!PaymentStatus},
    &apos;BCF&apos;, &apos;BCF&apos;,
    &apos;Chargeback&apos;, CASE({!Division},
        &apos;PVL&apos;, &apos;DIS&apos;,
        &apos;PVL Real Estate&apos;, &apos;DIS&apos;,
        &apos;BREG&apos;, &apos;BCD&apos;,
        &apos;CATV&apos;, &apos;CCD&apos;,
        &apos;HPEAP&apos;, &apos;HCD&apos;,
        &apos;OAH&apos;, &apos;ACD&apos;,
        &apos;RICO&apos;, &apos;RCD&apos;,
        &apos;INS&apos;, &apos;ICD&apos;,
        &apos;DFI&apos;, &apos;DCD&apos;,
        &apos;OCP&apos;, &apos;PCD&apos;, &apos;&apos;,
        &apos;PUC&apos;, &apos;&apos;
    ), &apos;&apos;)</expression>
    </formulas>
