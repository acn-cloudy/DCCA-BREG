    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_File_Number_and_Suffix</targetReference>
        </connector>
        <filterFormula>(ISPICKVAL({!$Record.Status}, &quot;Received&quot;) || ISPICKVAL({!$Record.Status}, &quot;Processing In Progress&quot;) || ISPICKVAL({!$Record.Status}, &quot;Pending Submission&quot;) || ISPICKVAL({!$Record.Status}, &quot;New&quot;)) 
