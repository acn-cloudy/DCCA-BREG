&amp;&amp; 
ISBLANK({!$Record.breg_File__c})
&amp;&amp; 
ISBLANK({!$Record.breg_File_Suffix__c})</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
