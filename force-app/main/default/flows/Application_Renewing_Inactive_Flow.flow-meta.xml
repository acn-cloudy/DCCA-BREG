        </defaultConnector>
        <defaultConnectorLabel>RSTR</defaultConnectorLabel>
        <rules>
            <name>RNEW</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Application.Type__c</leftValueReference>
                <operator>EqualTo</operator>
