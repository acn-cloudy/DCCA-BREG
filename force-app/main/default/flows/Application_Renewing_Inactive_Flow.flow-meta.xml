                    <stringValue>RNEW - Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>During_Renewal_Period_or_After</targetReference>
            </connector>
            <label>RNEW</label>
        </rules>
    </decisions>
    <description>JF 3/27/24- Remove query of existing renewal history</description>
    <environments>Default</environments>
    <formulas>
        <name>InactivationDateFormula</name>
        <dataType>Date</dataType>
        <expression>IF(
{!Get_Application.ApplicationRenewingInactive__c}, 
{!Get_Application.ApplicationReceivedDate__c}, 
null
)</expression>
    </formulas>
    <formulas>
        <name>LicenseStatusFormula</name>
        <dataType>String</dataType>
        <expression>IF(
OR(
TEXT({!Get_License.Status__c}) = &quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, 
TEXT({!Get_License.Status__c}) = &quot;DM - Forfeited/Maintenance Requirement Due&quot;),
&quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;C - Current, Valid &amp; In Good Standing&quot;
)</expression>
    </formulas>
    <formulas>
        <name>RenewingInactive</name>
        <dataType>Boolean</dataType>
        <expression>IF(
{!Get_Application.ApplicationRenewingInactive__c} = true, 
true, 
false
)</expression>
    </formulas>
