    <decisions>
        <name>During_Renewal_Period_or_After</name>
        <label>During Renewal Period or After?</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>During</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_License.EffectiveExpireDate__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Renew_License2</targetReference>
            </connector>
            <label>During</label>
        </rules>
        <rules>
            <name>After</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_License.EffectiveExpireDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Renew_LicenseAfter</targetReference>
            </connector>
            <label>After</label>
        </rules>
    </decisions>
