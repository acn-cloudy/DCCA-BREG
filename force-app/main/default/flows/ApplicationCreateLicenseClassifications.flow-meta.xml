    <decisions>
        <description>Ensure that requirements are fulfilled before proceeding</description>
        <name>ContinueLicenseClassifications</name>
        <label>Continue License Classifications</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HasCurrentLicenseTypeADDC</name>
            <conditionLogic>1 AND (2 OR 3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>CurrentLicense</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TypeADDC</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TypeREAC</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TypeLICF</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetApplicationClassifications</targetReference>
            </connector>
            <label>Has Current License Type ADDC</label>
        </rules>
    </decisions>
    <description>PacPoint: JF 03/07/2024 - Updated License Class Start Date to be App Class Effective Start Date, if App class effective start date is null, leave license class start date to be null</description>
    <environments>Default</environments>
    <formulas>
        <name>LicenseClassificationEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!ApplicationClassification.EffectiveStartDate__c}),null,{!ApplicationClassification.EffectiveStartDate__c})</expression>
    </formulas>
    <interviewLabel>Application:CreateLicenseClassifications {!$Flow.CurrentDateTime}</interviewLabel>
