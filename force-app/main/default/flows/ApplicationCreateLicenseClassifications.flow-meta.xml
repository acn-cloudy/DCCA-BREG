        <name>AddLicenseClassificationToList</name>
        <label>Add License Classification To List</label>
        <locationX>138</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>LicenseClassificationsToCreate</assignToReference>
            <operator>Add</operator>
