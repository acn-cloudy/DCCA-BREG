            <operator>Assign</operator>
            <value>
                <elementReference>CurrentLicense</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LicenseClassificationToCreate.EffectiveStartDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LicenseClassificationEffectiveDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LicenseClassificationToCreate.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>C - Current, Valid &amp; In Good Standing</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AddLicenseClassificationToList</targetReference>
        </connector>
    </assignments>
