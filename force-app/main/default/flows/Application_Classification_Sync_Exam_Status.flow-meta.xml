<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Exam_Needed</name>
        <label>Is Exam Needed?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Application_Classification.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CW - Class Withdrawn by Applicant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Application_Classification.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>H - Class Deferred by Board</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Application_Classification.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NE - No Exam Required--Class to be Licensed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Application_Classification.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NA - No Application</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Application_Classification.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>U - Class No Longer Needed Due To Upgrade To Higher Class</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Exam_Status</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>JF 11/29/23: Created for sync Application Classification status with exam status</description>
    <environments>Default</environments>
    <interviewLabel>Application Classification: Sync Exam Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Application Classification: Sync Exam Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Application_Classification</name>
        <label>Get Application Classification</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Exam_Needed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Classification__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ExamType__r.Classification__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Application__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Application__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ApplicationClassifications__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Exam_Status</name>
        <label>Update Exam Status</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Exam Not Required</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Application_Classification</targetReference>
        </connector>
        <object>ExamsRequired__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
