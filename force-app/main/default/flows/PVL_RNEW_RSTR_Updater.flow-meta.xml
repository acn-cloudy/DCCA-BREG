    <description>JF - 11/1/23 Cloned with updates for license renewing with permit to practice</description>
    <environments>Default</environments>
    <formulas>
        <name>DELQEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>{!PreviousLicenseEffectiveExpireDate} + 1</expression>
    </formulas>
    <formulas>
        <name>LicenseHistoryTransType</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!InputApplication.Type__c}) = &quot;RNEW - Renewal&quot;,
&quot;RNEW - RENEWED&quot;,
&quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;
)</expression>
    </formulas>
    <formulas>
        <name>LicensePeriod</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!InputApplication.Type__c}) = &quot;RNEW - Renewal&quot;,

TEXT(MONTH({!InputLicense.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!InputLicense.LicenseType__r.NextLicensePeriodEffectiveDate__c} ))
+ &quot;/&quot; 
+ TEXT(YEAR({!InputLicense.LicenseType__r.NextLicensePeriodEffectiveDate__c} ))
+ &quot; - &quot; 
+ TEXT(MONTH({!InputLicense.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!InputLicense.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!InputLicense.LicenseType__r.NextLicensePeriodExpireDate__c})), 

TEXT(MONTH({!InputLicense.LicenseType__r.PreviousLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!InputLicense.LicenseType__r.PreviousLicensePeriodEffectiveDate__c} ))
+ &quot;/&quot; 
+ TEXT(YEAR({!InputLicense.LicenseType__r.PreviousLicensePeriodEffectiveDate__c} ))
+ &quot; - &quot; 
+ TEXT(MONTH({!InputLicense.LicenseType__r.PreviousLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!InputLicense.LicenseType__r.PreviousLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!InputLicense.LicenseType__r.PreviousLicensePeriodExpireDate__c}))

)</expression>
    </formulas>
    <formulas>
        <name>LicenseRenewalStatus</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!InputLicense.Status__c}) = &quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, 
&quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;C - Current, Valid &amp; In Good Standing&quot;
)</expression>
    </formulas>
    <formulas>
        <name>LicenseStatusFormula</name>
        <dataType>String</dataType>
        <expression>IF(
OR(
TEXT({!InputLicense.Status__c}) = &quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, 
TEXT({!InputLicense.Status__c}) = &quot;DM - Forfeited/Maintenance Requirement Due&quot;),
&quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;C - Current, Valid &amp; In Good Standing&quot;
)</expression>
    </formulas>
    <formulas>
        <name>OnlineApplicationTypeFlow</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!InputApplication.OnlineApplicationType__c}) , &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Privilege</name>
        <dataType>String</dataType>
        <expression>IF(
(TEXT({!InputApplication.RenewingPermittoPractice__c}) = &apos;No&apos;),
&apos;&apos;,
TEXT({!InputApplication.CurrentLicense__r.Privilege__c})
)</expression>
    </formulas>
    <formulas>
        <name>Remarks</name>
        <dataType>String</dataType>
        <expression>TRIM(
    IF( 
        NOT(
            ISBLANK({!Privilege})
        )
        , &quot;RENEWED WITH &quot; + {!Privilege}
        , IF( 
            {!RenewingPermittoPractice} = &apos;No&apos;
            , &quot;RENEWED WITHOUT PERMIT TO PRACTICE&quot;
            , &quot;&quot;)) 
    + &quot; &quot;
    + IF( 
        NOT(
            ISBLANK({!OnlineApplicationTypeFlow}))
    ,&quot;ELECTRONIC RENEWAL&quot;
    ,&quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>RenewingPermittoPractice</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!InputApplication.RenewingPermittoPractice__c}),&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>RSTRDate</name>
        <dataType>Date</dataType>
        <expression>{!InputLicense.EffectiveExpireDate__c} + 1</expression>
    </formulas>
    <formulas>
        <name>TransactionType</name>
        <dataType>String</dataType>
        <expression>CASE({!InputApplication.Type__c}
    , &quot;RNEW - Renewal&quot;
    , &quot;RNEW - RENEWED&quot;
    , &quot;RSTR - Restore - No A/I Status&quot;
    , &quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;
    , &quot;&quot;
)</expression>
    </formulas>
