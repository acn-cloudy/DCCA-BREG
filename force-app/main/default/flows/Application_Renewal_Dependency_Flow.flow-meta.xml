    <formulas>
        <description>Used to select the Complete Application by Date based on Type of Application.</description>
        <name>CompleteApplicationByDate</name>
        <dataType>Date</dataType>
        <expression>IF(
TEXT({!$Record.Type__c}) = &quot;RNEW - Renewal&quot;,
{!$Record.CurrentLicense__r.EffectiveExpireDate__c} , 
{!$Record.CurrentLicense__r.RestorationDeadline__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to calculate what the license period should be set to on the Application.</description>
        <name>LicensePeriodFormula</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.Type__c}) = &quot;RNEW - Renewal&quot;, 
TEXT(MONTH({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.NextLicensePeriodEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.NextLicensePeriodExpireDate__c})),

TEXT(MONTH({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot; - &quot; 
+ TEXT(MONTH({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(DAY({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot; 
+ TEXT(YEAR({!$Record.LicenseType__r.LicenseTypeExpireDate__c}))

)</expression>
    </formulas>
    <formulas>
        <description>Status to Update the License to based on Previous Status</description>
        <name>LicenseRenewalStatus</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!$Record.CurrentLicense__r.PreviousStatus__c}) = &quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, 
&quot;CM - Current, Valid &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;C - Current, Valid &amp; In Good Standing&quot;
)</expression>
    </formulas>
    <formulas>
        <name>RestoreInactiveLicenseStatus</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!CurrentLicense.Status__c}), 
&quot;RM - Valid Thru Exp Date, Subject To Renwl/Maint Reqmt Due&quot;, &quot;CM - Current, Valid, &amp; In Good Standing/Maint. Requirement Due&quot;, 
&quot;R - Valid Thru Expiration Date, Subject To Renewal&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;D - Forfeited; Needs to Restore&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;DM - Forfeited/Maintenance Requirement Due&quot;, &quot;CM - Current, Valid, &amp; In Good Standing/Maint. Requirement Due&quot;,
 null)</expression>
    </formulas>
