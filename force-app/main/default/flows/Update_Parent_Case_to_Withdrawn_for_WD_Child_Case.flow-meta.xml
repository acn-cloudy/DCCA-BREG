    <decisions>
        <name>Case_Status</name>
        <label>Case Status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Filling_Withdrawn_Comment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>WD_Parent_is_Withdrawn</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Withdrawn</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_WD_case_status</targetReference>
            </connector>
            <label>WD Parent is Withdrawn</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_it_BREG_Case</name>
        <label>Is it BREG Case?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BREG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BREG_Case</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Status</targetReference>
            </connector>
            <label>BREG</label>
        </rules>
    </decisions>
    <description>Updates the parent Case status to Pending Withdrawal when a child Case is updated with Form Configuration = WD and Status = Received. Update WD case to Completed status when parent case status = Withdrawn</description>
    <environments>Default</environments>
    <formulas>
        <name>fNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
