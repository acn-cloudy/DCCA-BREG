<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Licenses_to_Collections</name>
        <label>Assign Licenses to Collections</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>LicenseCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UpdateLicense</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Check_Run_Inactivation_Flow_to_True</name>
        <label>Check Run Inactivation Flow to True</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignmentItems>
            <assignToReference>$Record.RunInactivationFlow__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Licenses_to_Collections</targetReference>
        </connector>
    </assignments>
    <description>JF 11/13/23 - This flow will be used to grab all Licenses who renewed Inactive (from active) and set a checkbox to trigger the Inactivation Flow.</description>
    <environments>Default</environments>
    <interviewLabel>License: Renewing Inactive Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>License: Renewing Inactive Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateLicense</name>
        <label>Update License</label>
        <locationX>176</locationX>
        <locationY>468</locationY>
        <inputReference>LicenseCollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Run_Inactivation_Flow_to_True</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RenewingInactive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>C - Current, Valid &amp; In Good Standing</stringValue>
            </value>
        </filters>
        <filters>
            <field>ActiveInactive__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>License__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-10-01</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>LicenseCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>License__c</objectType>
    </variables>
</Flow>
