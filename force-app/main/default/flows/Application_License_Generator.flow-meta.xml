    <description>PacPoint: MS 8/7/2024 Updated flow so that License Status = C - Current , Valid &amp; In Good Standing regardless the Application.LicensePeriod.
PacPoint JF 1/16/25: Updated to map the IMLCC License Id when license is generated
PacPoint JF 4/17/25: Updated to capture the temporary license information on license record

MTX SK 12/22/25: Updated to add IMLCC_Member__c checkbox mapping
MTX SK 01/09/26: Updated logic for R or C check</description>
    <environments>Default</environments>
    <formulas>
        <name>LicenseeEmail</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!Get_Source_Application.Applicant__r.BusinessEmail__c})),
   {!Get_Source_Application.Applicant__r.BusinessEmail__c},
   IF(
     AND(
      {!Get_Source_Application.Applicant__r.IsPersonAccount} = TRUE,
      NOT( ISBLANK({!Get_Source_Application.Applicant__r.PersonContact.Email}))
      ),
      {!Get_Source_Application.Applicant__r.PersonContact.Email},
      &quot;&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>LicenseEffectiveExpiryDate</name>
        <dataType>Date</dataType>
        <expression>IF(
   {!Get_Source_Application.LicenseType__r.RollingLicensePeriod__c} = TRUE,
    ADDMONTHS( {!Get_Source_Application.DateofLicensure__c},  {!Get_Source_Application.LicenseType__r.DurationofLicenseInMonths__c} ) ,
    IF(
          ISPICKVAL({!Get_Source_Application.LicensePeriod__c}, &quot;This License Period&quot;), 
          {!Get_Source_Application.LicenseType__r.LicenseTypeExpireDate__c} ,
          {!Get_Source_Application.LicenseType__r.NextLicensePeriodExpireDate__c} 
    ) 
)</expression>
    </formulas>
    <formulas>
        <name>LicenseStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Source_Application.LicensePeriod__c},
&quot;This License Period&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;This License Period + Renewal&quot;, &quot;CR - Current/Next Renewal Paid&quot;,
&quot;Next License Period&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;,
&quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>LicenseStatusRorC</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Source_Application.IMLCC_Member__c} &amp;&amp; {!Get_Source_Application.DateofLicensure__c} &gt;= {!Get_Source_Application.LicenseType__r.StartofRenewalPeriod__c} &amp;&amp; {!Get_Source_Application.DateofLicensure__c} &lt;= {!Get_Source_Application.LicenseType__r.EndofRenewalPeriod__c},
&quot;R - Valid Thru Expiration Date, Subject To Renewal&quot;, &quot;C - Current, Valid &amp; In Good Standing&quot;)</expression>
    </formulas>
