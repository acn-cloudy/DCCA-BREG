    <formulas>
        <name>Should_Include_Affiliation</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    OR(
        ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;DC-9&quot;),
        ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;X-7&quot;),
        ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;X-9&quot;)
    ),
    ISPICKVAL(
        {!Loop_Account_Affiliations.breg_Role__c},
        &quot;Agent&quot;
    ),
    IF(
        OR(
            ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;X-6&quot;),
            ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;ADD-MEMBER&quot;),
            ISPICKVAL({!Get_Form_Configuration.breg_Form_Code__c}, &quot;ODC&quot;)
        ),
        NOT(
            ISPICKVAL(
                {!Loop_Account_Affiliations.breg_Role__c},
                &quot;Agent&quot;
            )
        ),
        TRUE
    )
)</expression>
    </formulas>
