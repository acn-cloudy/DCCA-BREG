        <dataType>String</dataType>
        <expression>{!Get_Application.DependentApplication__r.LicenseType__r.Name}</expression>
    </formulas>
    <formulas>
        <name>DependentLicensePosition</name>
        <dataType>String</dataType>
        <expression>IF(
{!Get_Application.DependentLicense__r.LicenseType__r.Name} = &quot;RS&quot;,
&quot;RS - REAL ESTATE SALESPERSON (REAL ESTATE COMMISSION)&quot;,
IF({!Get_Application.DependentLicense__r.LicenseType__r.Name} = &quot;RB - Broker&quot;,
&quot;RBS - REAL ESTATE BROKER SALESPERSON (REAL ESTATE COMMISSION)&quot;,
null))</expression>
    </formulas>
    <formulas>
        <name>ExcludefromRenewalRollup</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Get_Current_License.LicenseTypeFormula__c} = &quot;PCFR&quot;,
true,
false)</expression>
    </formulas>
    <formulas>
        <name>LicensePeriod</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!Get_Current_License.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot;
+ TEXT(DAY({!Get_Current_License.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot;/&quot;
+ TEXT(YEAR({!Get_Current_License.LicenseType__r.LicenseTypeEffectiveDate__c}))
+ &quot; - &quot;
+ TEXT(MONTH({!Get_Current_License.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot;
+ TEXT(DAY({!Get_Current_License.LicenseType__r.LicenseTypeExpireDate__c}))
+ &quot;/&quot;
+ TEXT(YEAR({!Get_Current_License.LicenseType__r.LicenseTypeExpireDate__c}))</expression>
    </formulas>
    <formulas>
        <name>PositionStatus</name>
        <dataType>String</dataType>
        <expression>IF(
{!Get_Current_License.LicenseType__r.Name} = &quot;RS&quot;,
&quot;RS - REAL ESTATE SALESPERSON (REAL ESTATE COMMISSION)&quot;,
IF({!Get_Current_License.LicenseType__r.Name} = &quot;RB - Broker&quot;,
&quot;RBS - REAL ESTATE BROKER SALESPERSON (REAL ESTATE COMMISSION)&quot;,
null))</expression>
    </formulas>
    <formulas>
        <name>PositionStatusCheck</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Get_Application.DependentLicense__r.EntityPrincipalCounter__c} = 0,
TEXT({!Get_Application.DependentLicense__r.LicenseType__r.TypeofPositionStatus__c}),
NULL)</expression>
    </formulas>
    <formulas>
        <name>TransactionType</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Application.Type__c}
    , &quot;RNEW - Renewal&quot;
    , &quot;RNEW - RENEWED&quot;
    , &quot;RSTR - Restore - No A/I Status&quot;
    , &quot;RSTR - RESTORED (LICENSE WAS DELINQUENT/FORFEITED)&quot;
    , &quot;LICF - New License after Forfeiture&quot;
    , &quot;LICF - NEW LICENSE AFTER FORFEITURE&quot;
    , &quot;REAC - Reactivation&quot;
    , &quot;REAC - REACTIVATED&quot;
   , &quot;ADDP - Additional Special Privilege&quot;
    , &quot;ADDP - ADD SPECIAL PRIVILEGE&quot;
    , &quot;&quot;
)</expression>
    </formulas>
