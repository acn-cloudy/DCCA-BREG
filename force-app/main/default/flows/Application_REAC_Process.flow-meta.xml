    <formulas>
        <name>DependentApplicationPosition</name>
        <dataType>String</dataType>
        <expression>IF(
{!Get_Application.DependentApplication__r.LicenseType__r.Name} = &quot;RS&quot;,
&quot;RS - REAL ESTATE SALESPERSON (REAL ESTATE COMMISSION)&quot;,
IF({!Get_Application.DependentApplication__r.LicenseType__r.Name} = &quot;RB - Broker&quot;,
&quot;RBS - REAL ESTATE BROKER SALESPERSON (REAL ESTATE COMMISSION)&quot;,
null))</expression>
    </formulas>
    <formulas>
        <name>DependentLicense2Position</name>
        <dataType>String</dataType>
        <expression>IF(
{!Get_Application.DependentLicense2__r.LicenseType__r.Name} = &quot;RS&quot;,
&quot;RS - REAL ESTATE SALESPERSON (REAL ESTATE COMMISSION)&quot;,
IF({!Get_Application.DependentLicense2__r.LicenseType__r.Name} = &quot;RB - Broker&quot;,
&quot;RBS - REAL ESTATE BROKER SALESPERSON (REAL ESTATE COMMISSION)&quot;,
null))</expression>
    </formulas>
    <formulas>
